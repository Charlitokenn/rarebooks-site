---
import {AppConfig} from "../constants";
interface Props {
  title?: string
  description?: string
  canonicalPath?: string
  ogType?: string
  /** Adds a robots noindex meta tag, for pages search engines must not list (the /design-system preview). */
  noindex?: boolean
  /**
   * Preloads both Fraunces files (roman and italic). Set it on pages with a display or h1 heading above the
   * fold, whose hero usually holds an MkHighlight, so the italic is needed at once (spec 0017 AC-7).
   */
  preloadSerif?: boolean
  /** A site path to a 1200 by 630 social image, such as "/og/home.jpg" (spec 0019 AC-13). */
  ogImage?: string
  /** The social image's alt text, written with `ogImage`. */
  ogImageAlt?: string
  /** Schema.org structured data, written as one ld+json script in the head (spec 0020 AC-13). */
  jsonLd?: object
}

const {
  title = AppConfig.appName,
  description = AppConfig.description,
  canonicalPath,
  ogType = "website",
  noindex = false,
  preloadSerif = false,
  ogImage,
  ogImageAlt,
  jsonLd,
} = Astro.props

// marketing.css imports global.css first and only adds the `mk` design system on top (spec 0017 AC-3).
import "../styles/marketing.css"
// `?url` gives the hashed build paths, the same files marketing.css's @font-face rules point at.
import frauncesRomanUrl from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url"
import frauncesItalicUrl from "@fontsource-variable/fraunces/files/fraunces-latin-wght-italic.woff2?url"
// import { ClientRouter } from 'astro:transitions';
import TawkWidget from "@components/TawkWidget.astro";
import { jsonLdText } from "../lib/marketing/jsonLd.ts";

// Spec 0022 AC-9: the PostHog project key, a public `phc_` key set in production only. Empty or missing
// means no snippet and no /ingest request (local dev, previews).
let posthogKey = ""
try {
  const { env } = await import("cloudflare:workers")
  posthogKey = (env as { PUBLIC_POSTHOG_KEY?: string }).PUBLIC_POSTHOG_KEY ?? ""
} catch {
  // No Worker env (a Node prerender): leave analytics off.
}

const signUpUrl = AppConfig.urls.signUpUrl
const supportEmail = AppConfig.emails.supportEmail

const canonicalUrl = canonicalPath ? new URL(canonicalPath, AppConfig.urls.rootUrl).toString() : undefined
const ogImageUrl = ogImage ? new URL(ogImage, AppConfig.urls.rootUrl).toString() : undefined
---

<!doctype html>
<html lang="en" class="bg-background">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fbfafc" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {preloadSerif && (
      <>
        <link rel="preload" as="font" type="font/woff2" crossorigin href={frauncesRomanUrl} />
        <link rel="preload" as="font" type="font/woff2" crossorigin href={frauncesItalicUrl} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content={AppConfig.appName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
        <meta name="twitter:image" content={ogImageUrl} />
      </>
    )}
    <title>{title}</title>
    {jsonLd && <script type="application/ld+json" set:html={jsonLdText(jsonLd)} />}
    <!--<ClientRouter />-->
    {
      /*
        PostHog's official snippet (spec 0022 AC-7): under 2 KB, it only defines the `posthog` stub. `init`
        runs on the window load event, so the library (/ingest/static/array.js) is requested after load and
        stays out of first paint. Calls made before then wait in `__rbPending` (see `rbTrack` below).
      */
      posthogKey && (
        <script is:inline define:vars={{ posthogKey }}>
          !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],Object.defineProperty(u,"toString",{configurable:!0,enumerable:!0,writable:!0,value:function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e}}),Object.defineProperty(u.people,"toString",{configurable:!0,enumerable:!0,writable:!0,value:function(){return u.toString(1)+".people (stub)"}}),o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagResult isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
          window.addEventListener("load", function () {
            window.posthog.init(posthogKey, {
              api_host: "/ingest",
              ui_host: "https://eu.posthog.com",
              capture_pageview: true,
              autocapture: false,
              disable_session_recording: true,
              disable_surveys: true,
              advanced_disable_flags: true,
              person_profiles: "identified_only",
              persistence: "cookie",
            });
            var pending = window.__rbPending || [];
            window.__rbPending = [];
            pending.forEach(function (event) {
              window.posthog.capture(event[0], event[1]);
            });
          });
        </script>
      )
    }
  </head>
  <body class="min-h-screen overflow-x-hidden">
    <slot />
    <TawkWidget load="interaction" />
  </body>
</html>

<style is:global>
  /*
    The AC-3 fallback message that follows each Contact us link. Empty, it is visually hidden and out of the
    layout (so adding it at DOM ready shifts nothing, even inside a flex row with a gap), but it stays in the
    accessibility tree so the message is announced when it fills.
  */
  .rb-chat-status:empty {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .rb-chat-status:not(:empty) {
    display: block;
    margin-top: 0.5rem;
  }
  .rb-chat-status a {
    font-weight: 700;
    color: var(--mk-link);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>

<!--
  The marketing pages' one click handler (spec 0022):
  - `rbTrack` sends an event to PostHog when it is configured (AC-6), queued until `posthog.init` runs on
    load (AC-7), and dropped when there is no key (AC-9). It never identifies the visitor.
  - A "Start free trial" link (href equal to `signUpUrl` and a `data-cta-location`) records `trial_interest`.
  - A Contact us link (`data-open-chat`, a mailto link) records `contact_click` and, on a plain left click,
    opens the tawk.to chat through `rbOpenChat` instead of email (AC-3).
  - Any `[data-open-modal]` trigger (MkNav's menu, the homepage demo) opens its dialog.
-->
<script is:inline define:vars={{ signUpUrl, supportEmail }}>
  (function () {
    var FALLBACK_MS = 8000;

    function rbTrack(name, props) {
      var ph = window.posthog;
      if (!ph) return;
      if (typeof ph.capture === "function") ph.capture(name, props);
      else (window.__rbPending = window.__rbPending || []).push([name, props]);
    }

    // --- The chat (AC-3) ---------------------------------------------------------------------------------
    // TawkWidget sets `Tawk_API.onLoad` (the Secure Mode login) and `window.rbLoadChat`. The hooks below wrap
    // `onLoad` and `onChatMaximized`, never replace them, and are added at DOM ready, after TawkWidget's
    // script has run. `ready` is also set by the wrapper, so a chat that loaded before the wrap still counts.
    var ready = false;
    var wantMaximize = false;
    var opened = false;
    var timer = null;

    function tawk() {
      return (window.Tawk_API = window.Tawk_API || {});
    }

    function markOpened() {
      opened = true;
      wantMaximize = false;
      if (timer) clearTimeout(timer);
      timer = null;
    }

    function isMaximized() {
      var api = tawk();
      try {
        return typeof api.isChatMaximized === "function" && api.isChatMaximized() === true;
      } catch (err) {
        return false;
      }
    }

    function maximize() {
      var api = tawk();
      try {
        if (typeof api.maximize === "function") api.maximize();
      } catch (err) {
        // tawk.to failed inside; the 8 second fallback tells the visitor to write instead.
      }
      if (isMaximized()) markOpened();
    }

    function hookTawk() {
      var api = tawk();
      if (typeof api.isChatMaximized === "function") ready = true;
      var prevLoad = api.onLoad;
      api.onLoad = function () {
        ready = true;
        if (typeof prevLoad === "function") prevLoad.apply(this, arguments);
        if (wantMaximize) maximize();
      };
      var prevMax = api.onChatMaximized;
      api.onChatMaximized = function () {
        markOpened();
        if (typeof prevMax === "function") prevMax.apply(this, arguments);
      };
    }

    function statusFor(control) {
      var next = control.nextElementSibling;
      return next && next.classList.contains("rb-chat-status") ? next : null;
    }

    function showFallback(status) {
      if (!status) return;
      var link = document.createElement("a");
      link.href = "mailto:" + supportEmail;
      link.textContent = supportEmail;
      status.textContent = "";
      status.append("Chat could not load. Write to ", link, ".");
    }

    window.rbOpenChat = function (control) {
      document.querySelectorAll(".rb-chat-status").forEach(function (s) {
        s.textContent = "";
      });
      opened = false;
      if (timer) clearTimeout(timer);
      if (ready && isMaximized()) {
        markOpened();
        return;
      }
      var status = statusFor(control);
      timer = setTimeout(function () {
        timer = null;
        if (!opened) showFallback(status);
      }, FALLBACK_MS);
      if (typeof window.rbLoadChat === "function") window.rbLoadChat();
      if (ready) maximize();
      else wantMaximize = true;
    };

    function onReady() {
      hookTawk();
      document.querySelectorAll("[data-open-chat]").forEach(function (control) {
        if (statusFor(control)) return;
        var status = document.createElement("span");
        status.className = "rb-chat-status";
        status.setAttribute("role", "status");
        status.setAttribute("aria-live", "polite");
        control.after(status);
      });
    }
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", onReady);
    else onReady();

    // --- Clicks ------------------------------------------------------------------------------------------
    var trialSelector = 'a[href="' + signUpUrl + '"][data-cta-location]';

    document.addEventListener("click", function (e) {
      var trial = e.target.closest(trialSelector);
      if (trial) {
        rbTrack("trial_interest", {
          cta_location: trial.getAttribute("data-cta-location") || "unknown",
          plan_name: trial.getAttribute("data-plan-name") || null,
        });
        return;
      }

      var chat = e.target.closest("[data-open-chat]");
      if (chat) {
        rbTrack("contact_click", { cta_location: chat.getAttribute("data-cta-location") || "unknown" });
        // Only a plain left click opens the chat; any other click opens email as a normal link.
        if (e.button !== 0 || e.ctrlKey || e.metaKey || e.shiftKey || e.altKey) return;
        e.preventDefault();
        window.rbOpenChat(chat);
        return;
      }

      var btn = e.target.closest("[data-open-modal]");
      if (!btn) return;
      var dialog = document.getElementById(btn.getAttribute("data-open-modal"));
      if (dialog && typeof dialog.showModal === "function") dialog.showModal();
    });
  })();
</script>
