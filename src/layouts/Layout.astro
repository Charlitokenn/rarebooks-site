---
import {AppConfig} from "../constants";
interface Props {
  title?: string
  description?: string
  canonicalPath?: string
  ogType?: string
  /** Adds a robots noindex meta tag, for pages search engines must not list (the /design-system preview). */
  noindex?: boolean
  /**
   * Preloads both Fraunces files (roman and italic). Set it on pages with a display or h1 heading above the
   * fold, whose hero usually holds an MkHighlight, so the italic is needed at once (spec 0017 AC-7).
   */
  preloadSerif?: boolean
  /** A site path to a 1200 by 630 social image, such as "/og/home.jpg" (spec 0019 AC-13). */
  ogImage?: string
  /** The social image's alt text, written with `ogImage`. */
  ogImageAlt?: string
}

const {
  title = AppConfig.appName,
  description = AppConfig.description,
  canonicalPath,
  ogType = "website",
  noindex = false,
  preloadSerif = false,
  ogImage,
  ogImageAlt,
} = Astro.props

// marketing.css imports global.css first and only adds the `mk` design system on top (spec 0017 AC-3).
import "../styles/marketing.css"
// `?url` gives the hashed build paths, the same files marketing.css's @font-face rules point at.
import frauncesRomanUrl from "@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url"
import frauncesItalicUrl from "@fontsource-variable/fraunces/files/fraunces-latin-wght-italic.woff2?url"
// import { ClientRouter } from 'astro:transitions';
import TawkWidget from "@components/TawkWidget.astro";

const canonicalUrl = canonicalPath ? new URL(canonicalPath, AppConfig.urls.rootUrl).toString() : undefined
const ogImageUrl = ogImage ? new URL(ogImage, AppConfig.urls.rootUrl).toString() : undefined
---

<!doctype html>
<html lang="en" class="bg-background">
  <head>
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
          new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-W4VTMZRK');</script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#fbfafc" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {preloadSerif && (
      <>
        <link rel="preload" as="font" type="font/woff2" crossorigin href={frauncesRomanUrl} />
        <link rel="preload" as="font" type="font/woff2" crossorigin href={frauncesItalicUrl} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:site_name" content={AppConfig.appName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && (
      <>
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}
        <meta name="twitter:image" content={ogImageUrl} />
      </>
    )}
    <link rel="preconnect" href="https://challenges.cloudflare.com" />
    <script
        src="https://challenges.cloudflare.com/turnstile/v0/api.js"
        async
        defer
    ></script>
    <title>{title}</title>
    <!--<ClientRouter />-->
  </head>
  <body class="min-h-screen overflow-x-hidden">
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W4VTMZRK"
                    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
    <slot />
    <TawkWidget />
  </body>
</html>

<script is:inline>
  (function onTurnstileError(errorCode) {
      console.error("Turnstile error:", errorCode);
      document.getElementById("send-free-license").disabled = true;
    }
  )();
  (function onTurnstileSuccess() {
    document.getElementById("turnstile-container").hidden = true;
  })()
</script>

<!--
  Centralized "open modal" handler for every [data-open-modal] trigger on the
  site (the homepage's demo, Talk to us and Contact us buttons, MkNav's menu,
  the Compare/Alternatives pages). This replaces the near-identical copies that used to live in
  index.astro, CompareLayout.astro, and AlternativesLayout.astro.

  It also tracks trial intent: a click on a "Start free trial" link (each
  goes to Clerk sign up, spec 0014 AC-7) pushes a `trial_interest` event to
  the GTM dataLayer, with the plan when the link is a pricing plan's.
-->
<script is:inline>
  (function () {
    window.dataLayer = window.dataLayer || [];

    document.addEventListener("click", function (e) {
      const trial = e.target.closest('a[href="/auth/sign-up"][data-cta-location]');
      if (trial) {
        window.dataLayer.push({
          event: "trial_interest",
          cta_location: trial.getAttribute("data-cta-location") || "unknown",
          plan_name: trial.getAttribute("data-plan-name") || null,
        });
        return;
      }
      const btn = e.target.closest("[data-open-modal]");
      if (!btn) return;

      const modalId = btn.getAttribute("data-open-modal");
      const dialog = document.getElementById(modalId);

      if (modalId === "desktop-payment-modal") {
        const planName = btn.getAttribute("data-plan-name");
        const planPrice = btn.getAttribute("data-plan-price");
        const currency = btn.getAttribute("data-currency");
        const ctaLocation = btn.getAttribute("data-cta-location") || "unknown";

        // Lets a future purchase-completed step (once payments are automated) attribute back to this click
        // without re-deriving it.
        sessionStorage.setItem(
          "rb_purchase_plan",
          JSON.stringify({
            plan_name: planName,
            plan_price: planPrice || null,
            currency: currency || null,
          })
        );

        window.dataLayer.push({
          event: "purchase_interest",
          cta_location: ctaLocation,
          plan_name: planName || null,
          plan_price: planPrice || null,
          billing_period: "one_time",
          currency: currency || null,
        });
      }

      if (dialog && typeof dialog.showModal === "function") {
        dialog.showModal();
      }
    });
  })();
</script>

<!--
  "Send payment confirmation via chat" handler for the desktop payment
  modal (DesktopPaymentModal.astro). Mirrors the [data-gtm-download]
  pattern below: opts in via [data-gtm-payment-confirm], fires a
  `payment_confirmation_started` event - the step after `purchase_interest`
  in the manual Lipa Namba funnel - copies a pre-filled confirmation
  message to the clipboard, opens the Tawk chat widget, and closes the
  modal so the visitor can paste the message straight into the chat.
-->
<script is:inline>
  (function () {
    window.dataLayer = window.dataLayer || [];

    document.addEventListener("click", function (e) {
      const btn = e.target.closest("[data-gtm-payment-confirm]");
      if (!btn) return;

      const planName = btn.getAttribute("data-plan-name");
      const planPrice = btn.getAttribute("data-plan-price");
      const currency = btn.getAttribute("data-currency");
      const paymentMethod = btn.getAttribute("data-payment-method") || "unknown";
      const ctaLocation = btn.getAttribute("data-cta-location") || "unknown";
      const message = btn.getAttribute("data-confirmation-message") || "";

      window.dataLayer.push({
        event: "payment_confirmation_started",
        cta_location: ctaLocation,
        plan_name: planName || null,
        plan_price: planPrice || null,
        currency: currency || null,
        payment_method: paymentMethod,
      });

      if (message && navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(message).catch(function () {});
      }

      const note = document.getElementById("payment-confirm-note");
      if (note) {
        note.classList.remove("hidden");
        setTimeout(function () {
          note.classList.add("hidden");
        }, 6000);
      }

      const dialog = btn.closest("dialog.modal-dialog");
      if (dialog && typeof dialog.close === "function") {
        dialog.close();
      }

      if (window.Tawk_API && typeof window.Tawk_API.maximize === "function") {
        window.Tawk_API.maximize();
      }
    });
  })();
</script>

<!--
  "Buy Lifetime License" PayPal button click, from the international-buyer
  branch of DesktopPaymentModal.astro. Since the PayPal button is a real
  <form> that submits to PayPal in a new tab (target="_blank"), this just
  records the click before the browser follows through - it does not
  intercept or delay the submission. Fires `payment_checkout_started`, one
  step before `payment_confirmation_started` above in the PayPal funnel.
-->
<script is:inline>
  (function () {
    window.dataLayer = window.dataLayer || [];

    document.addEventListener("click", function (e) {
      const btn = e.target.closest("[data-gtm-payment-interest]");
      if (!btn) return;

      window.dataLayer.push({
        event: "payment_checkout_started",
        cta_location: btn.getAttribute("data-cta-location") || "unknown",
        plan_name: btn.getAttribute("data-plan-name") || null,
        plan_price: btn.getAttribute("data-plan-price") || null,
        currency: btn.getAttribute("data-currency") || null,
        payment_method: "paypal",
      });
    });
  })();
</script>

<!--
  Centralized "software download" click tracker for every
  [data-gtm-download] link on the site (none since the desktop trial was
  retired in spec 0014; kept for a Microsoft Store link added later). Fires
  a `software_download` event to the GTM dataLayer.

  Elements opt in with `data-gtm-download`, and can optionally carry:
    data-download-source  e.g. "pricing_page"
    data-license-type     e.g. "lifetime"
    data-country
  This is a separate listener (not folded into the modal-open handler
  above) since download links aren't modal triggers - same pattern used
  for the backdrop-close vs modal-close listeners in the modals.
-->
<script is:inline>
  (function () {
    window.dataLayer = window.dataLayer || [];

    document.addEventListener("click", function (e) {
      const link = e.target.closest("[data-gtm-download]");
      if (!link) return;

      window.dataLayer.push({
        event: "software_download",
        download_source: link.getAttribute("data-download-source") || "unknown",
        license_type: link.getAttribute("data-license-type") || null,
        country: link.getAttribute("data-country") || null,
      });
    });
  })();
</script>