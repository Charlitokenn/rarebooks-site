---
import { AppConfig } from "../constants";
interface Props {
    title?: string
    description?: string
    breadcrumbs?: Crumb[];
}

const {
    title = AppConfig.appName,
    description = AppConfig.description,
} = Astro.props

import "../styles/global.css"
import { ClientRouter } from "astro:transitions";
import { Show } from '@clerk/astro/components'

import { PersistedSidebarShell } from "../components/components/persisted-sidebar.tsx";
import { DashboardHeader, type Crumb } from "../components/components/dashboard-header.tsx";
import { SIDEBAR_COOKIE_NAME } from "../stores/sidebar";

const path = Astro.url.pathname;
const segments = path.split('/').filter(Boolean);

const autoCrumbs = segments.map((seg, i) => {
    const href = '/' + segments.slice(0, i + 1).join('/');
    const label = seg.charAt(0).toUpperCase() + seg.slice(1);
    return i === segments.length - 1
        ? { label }          // last segment = current page, no link
        : { label, href };
});

// Use autoCrumbs as the default, allow pages to override via prop
const { breadcrumbs = autoCrumbs } = Astro.props;

// `currentUser()` is async — must be awaited, or this becomes an
// unresolved Promise getting serialized into the client island below.
const userDetails = await Astro.locals.currentUser();
const firstName = userDetails?.firstName;
const email = userDetails?.emailAddresses?.[0]?.emailAddress ?? "";
// Read the same cookie the sidebar itself writes to (see SidebarProvider's
// `setOpen`), so the very first SSR paint of this wrapper already reflects
// the user's last choice instead of always assuming "expanded". This is
// the same cookie-read-on-the-server pattern shadcn's own docs use.
const sidebarStateCookie = Astro.cookies.get(SIDEBAR_COOKIE_NAME)?.value;
const sidebarOpen = sidebarStateCookie !== "false";
const sidebarState = sidebarOpen ? "expanded" : "collapsed";

// Create a secure mode for tawk.to using hmac
async function hmacSha256(email: string, secret: string): Promise<string> {
    const key = await crypto.subtle.importKey("raw", new TextEncoder().encode(secret), { name: "HMAC", hash: "SHA-256" }, false, ["sign"]);
    const sig = await crypto.subtle.sign("HMAC", key, new TextEncoder().encode(email));
    return Array.from(new Uint8Array(sig)).map(b => b.toString(16).padStart(2, "0")).join("");
}

const hash = email ? await hmacSha256(email, AppConfig.tawk.siteKey) : "";
---

<!doctype html>
<html lang="en" class="bg-background">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#5b3df5" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <title>{title}</title>
    <!--
      Enables Astro's client-side routing. Without this, every sidebar
      link is a full document reload — that hard reload is what was
      causing the dashboard "flicker."
    -->
    <ClientRouter />
</head>
<body class="min-h-screen overflow-x-hidden">
    <!--
      `clerkMiddleware` in src/middleware.ts already redirects unauthenticated
      requests to /dashboard(.*) before this page ever renders, so this is
      just a defense-in-depth guard — not the primary auth gate.
    -->
    <Show when="signed-in">
        <!--
          This wrapping div previously lived inside <SidebarProvider>'s own
          render output. It now lives here in plain Astro markup instead,
          so it can be a shared DOM parent for two *separate* React roots:
          the persisted sidebar and the per-page main content.

          `data-state` here is the SSR-correct value read from the cookie
          above, and is kept live-in-sync (without a navigation) by the
          inline script at the bottom, which listens to the same
          `$sidebarOpen` store the sidebar itself writes to. We deliberately
          do NOT depend on peer-data-[...] selectors for this anymore —
          the actual sidebar `.peer` element now lives one level deeper,
          inside its own <astro-island>, so it's no longer a true DOM
          sibling of <main> and peer-* selectors can't reach it.
        -->
        <div
            data-slot="sidebar-wrapper"
            data-state={sidebarState}
            class="group/sidebar-wrapper flex min-h-svh w-full has-data-[variant=inset]:bg-sidebar"
            style="--sidebar-width:16rem;--sidebar-width-icon:3rem;"
        >
            <!--
              The ONLY island that persists across dashboard navigations.
              It owns the sidebar's open/collapsed/mobile state, so that
              state (and the component itself) survives client-side route
              changes instead of being torn down and rebuilt on every click.
            -->
            <PersistedSidebarShell
                client:load
                transition:persist="dashboard-sidebar"
                path={path}
                user={userDetails}
            />

            <!--
              Plain Astro markup — NOT persisted, NOT React. This is the
              part that's meant to change on every navigation, so it's
              free to do so. Spacing now reacts to the `data-state`
              attribute on the ancestor wrapper div above (group-data-*,
              which matches across any DOM depth) instead of peer-data-*
              (which needs true siblings and breaks across islands).
            -->
            <main
                data-slot="sidebar-inset"
                class="relative flex w-full flex-1 flex-col bg-background md:group-data-[variant=inset]/sidebar-wrapper:m-2 md:group-data-[variant=inset]/sidebar-wrapper:ml-0 md:group-data-[variant=inset]/sidebar-wrapper:rounded-xl md:group-data-[variant=inset]/sidebar-wrapper:shadow-sm md:group-data-[state=collapsed]/sidebar-wrapper:ml-2"
            >
                <!--
                  Re-renders fresh on every navigation (this is what we
                  want — breadcrumbs need to update per route). It's cheap,
                  and with the ClientRouter above, swapping it in is an
                  instant client-side transition, not a hard reload.
                -->
                <DashboardHeader breadcrumbs={breadcrumbs} client:load />
                <div class="flex-1 overflow-auto p-4">
                    <slot />
                </div>
            </main>
        </div>

        <script>
            // Keeps the wrapper's `data-state` attribute in sync with the
            // sidebar's live open/collapsed state when the user toggles it
            // *without* a navigation (a navigation already gets the right
            // value server-side, from the cookie read above). Per Astro's
            // view-transitions docs, bundled module scripts only execute
            // once and are not re-run on client-side navigations — that's
            // fine here, since the callback below re-queries the DOM live
            // on every store change, so it always finds whichever wrapper
            // div is currently on the page.
            import { $sidebarOpen } from "../stores/sidebar";

            $sidebarOpen.listen((open) => {
                document
                    .querySelector('[data-slot="sidebar-wrapper"]')
                    ?.setAttribute("data-state", open ? "expanded" : "collapsed");
            });
        </script>
    </Show>
    <!--Start of Tawk.to Script-->
    //TODO: Fix to push client full name and email to the support dashboard
    <script define:vars={{ firstName, email, hash }} type="text/javascript">
        var Tawk_API=Tawk_API||{}, Tawk_LoadStart=new Date();
            Tawk_API.setAttributes = {
                name : firstName,
                email : email,
                hash: hash
            };
        (function(){
            var s1=document.createElement("script"),s0=document.getElementsByTagName("script")[0];
            s1.async=true;
            s1.src='https://embed.tawk.to/6a43b438854f801d4378af24/1jsc7fva2';
            s1.charset='UTF-8';
            s1.setAttribute('crossorigin','*');
            s0.parentNode.insertBefore(s1,s0);
        })();
    </script>
    <!--End of Tawk.to Script-->
</body>
</html>
