---
import {AppConfig} from "../constants";
interface Props {
    title?: string
    description?: string
    breadcrumbs?: Crumb[];
}

const {
    title = AppConfig.appName,
    description = AppConfig.description,
} = Astro.props

import "../styles/global.css"
import { Show, SignIn } from '@clerk/astro/components'

import { ClientPortalShell, type Crumb } from "../components/components/clientPortalShell.tsx";
import {TooltipProvider} from "@components/components/ui/tooltip.tsx";
import {SidebarInset, SidebarProvider, SidebarTrigger} from "@components/components/ui/sidebar.tsx";
import {AppSidebar} from "@components/components/app-sidebar.tsx";
import {Separator} from "@components/components/ui/separator.tsx";
import {
    Breadcrumb,
    BreadcrumbItem,
    BreadcrumbLink,
    BreadcrumbList, BreadcrumbPage,
    BreadcrumbSeparator
} from "@components/components/ui/breadcrumb.tsx";
import {Home} from "lucide-react";
import React from "react";

const path = Astro.url.pathname;
const segments = path.split('/').filter(Boolean);

const autoCrumbs = segments.map((seg, i) => {
    const href = '/' + segments.slice(0, i + 1).join('/');
    const label = seg.charAt(0).toUpperCase() + seg.slice(1);
    return i === segments.length - 1
        ? { label }          // last segment = current page, no link
        : { label, href };
});

// Use autoCrumbs as the default, allow pages to override via prop
const { breadcrumbs = autoCrumbs } = Astro.props;

const userDetails = Astro.locals.currentUser()
---

<!doctype html>
<html lang="en" class="bg-background">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#5b3df5" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <title>{title}</title>
</head>
<body class="min-h-screen overflow-x-hidden">
    <Show when="signed-out">
        <SignIn />
    </Show>
    <Show when="signed-in">
        <ClientPortalShell breadcrumbs={breadcrumbs} path={path} user={userDetails} client:only="react">
            <slot />
        </ClientPortalShell>
    </Show>
</body>
</html>