---
// The plain reception layout of /welcome (spec 0023 AC-11), on every outcome: the logo, Clerk's UserButton
// (manage account and sign out, which goes to `/`, set on the Clerk integration), the dashboard chat loaded
// at once, and no sidebar or breadcrumbs. The page reads `currentUser()` once and passes the user in.
import "../styles/global.css";
import { UserButton } from "@clerk/astro/components";
import TawkWidget from "@components/TawkWidget.astro";
import MkLogo from "@components/marketing/MkLogo.astro";

interface Props {
  user: Awaited<ReturnType<App.Locals["currentUser"]>>;
}

const { user } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-background">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#5b3df5" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <title>Welcome to RareBooks</title>
  </head>
  <body class="min-h-svh overflow-x-hidden bg-background text-foreground">
    <header class="border-b px-4 sm:px-6">
      <div class="mx-auto flex h-16 w-full max-w-3xl items-center justify-between gap-4">
        <MkLogo />
        <UserButton />
      </div>
    </header>
    <main id="main" class="px-4 py-10 sm:px-6">
      <slot />
    </main>
    <TawkWidget load="eager" widget="dashboard" user={user} />
  </body>
</html>
