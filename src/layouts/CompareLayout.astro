---
// A /compare/<slug> page (spec 0021 AC-11): six mk bands between MkNav and MkFooter, with the words from the
// spec's Page copy. The body varies by country and sign in state; the head never does (AC-7).
import MkButton from "@components/marketing/MkButton.astro";
import MkCard from "@components/marketing/MkCard.astro";
import MkFooter from "@components/marketing/MkFooter.astro";
import MkHeading from "@components/marketing/MkHeading.astro";
import MkNav from "@components/marketing/MkNav.astro";
import MkSection from "@components/marketing/MkSection.astro";
import CompareHero from "@components/marketing/compare/CompareHero.astro";
import CompareTable from "@components/marketing/compare/CompareTable.astro";
import HomeCta from "@components/marketing/home/HomeCta.astro";
import Layout from "./Layout.astro";
import { AppConfig } from "../constants";
import { homeCopy } from "../constants/home.ts";
import { fillRareBooks, rareBooksRowsFor, rareBooksValues, type CompetitorEntry } from "../data/competitors.ts";
import { breadcrumbJsonLd } from "../lib/marketing/breadcrumb.ts";
import { fill } from "../lib/marketing/home.ts";

interface Props {
  entry: CompetitorEntry;
  local: boolean;
  signedIn: boolean;
}

const { entry, local, signedIn } = Astro.props;
const { name, shortName, slug } = entry;
const pageName = `RareBooks vs ${shortName}`;
const rareBooksRows = rareBooksRowsFor(local);
const text = (value: string) => fillRareBooks(value, local);
const values = { ...rareBooksValues(local), name, shortName, slug };
const cta = {
  title: "Ready to switch to *RareBooks*?",
  lead: fill("Try every feature free for {freeDays} days, with no card needed.", values),
  primary: "Start free trial",
};
---

<Layout
  title={`RareBooks vs ${shortName} | Platform Comparison`}
  description={entry.metaDescription}
  canonicalPath={`/compare/${slug}`}
  ogImage="/og/home.jpg"
  ogImageAlt={homeCopy.abroad.hero.screenshotAlt}
  preloadSerif
  jsonLd={breadcrumbJsonLd(AppConfig.urls.rootUrl, "compare", slug, pageName)}
>
  <MkNav />
  <main id="main">
    <CompareHero
      section={{ name: "Compare", href: "/compare" }}
      pageName={pageName}
      overline="Comparison"
      title={`RareBooks vs *${shortName}*`}
      lead={fill(
        "How RareBooks and {name} compare on price, features and fit, so you can pick the one that suits how your business runs.",
        values,
      )}
      location="compare_page_header"
      secondary={{ label: "See pricing", href: "/pricing" }}
      signedIn={signedIn}
    />

    <MkSection tone="tint" labelledby="compare-fit-title">
      <MkHeading level={2} id="compare-fit-title" align="center">Price and fit</MkHeading>
      <div class="mx-auto mt-10 grid max-w-4xl gap-6 md:mt-12 md:grid-cols-2">
        <MkCard as="article" class="border-2 border-mk-brand">
          <MkHeading level={3}>RareBooks pricing</MkHeading>
          <p class="mt-3">{rareBooksRows.price}</p>
          <p class="mt-2 text-(--mk-subtle)">{fill("Free for {freeDays} days, no card needed.", values)}</p>
        </MkCard>
        <MkCard as="article">
          <MkHeading level={3}>{shortName} pricing</MkHeading>
          <p class="mt-3 text-(--mk-subtle)">{entry.pricingCompetitor}</p>
        </MkCard>
        <MkCard as="article" class="border-2 border-mk-brand">
          <MkHeading level={3}>Best for RareBooks</MkHeading>
          <p class="mt-3">{text(entry.bestForRareBooks)}</p>
        </MkCard>
        <MkCard as="article">
          <MkHeading level={3}>Best for {shortName}</MkHeading>
          <p class="mt-3 text-(--mk-subtle)">{entry.bestForCompetitor}</p>
        </MkCard>
      </div>
    </MkSection>

    <MkSection tone="canvas" labelledby="compare-table-title">
      <MkHeading level={2} id="compare-table-title" align="center">Feature by feature</MkHeading>
      <div class="mx-auto mt-10 max-w-4xl md:mt-12">
        <CompareTable shortName={shortName} rareBooks={rareBooksRows} competitor={entry.rows} />
      </div>
    </MkSection>

    <MkSection tone="tint" aria-label="Deep dives">
      <div class="space-y-16 md:space-y-24">
        {
          entry.deepDives.map((dive, index) => (
            <div>
              <MkHeading level={2} id={`compare-dive-${index + 1}`} align="center">
                {dive.title}
              </MkHeading>
              <p class="mx-auto mt-4 max-w-2xl text-center text-pretty text-mk-lead text-(--mk-subtle)">
                {dive.intro}
              </p>
              <div class="mx-auto mt-10 grid max-w-4xl gap-6 md:grid-cols-2">
                <MkCard as="article" class="border-2 border-mk-brand">
                  <MkHeading level={3}>{dive.rarebooks.heading}</MkHeading>
                  <p class="mt-3">{text(dive.rarebooks.body)}</p>
                </MkCard>
                <MkCard as="article">
                  <MkHeading level={3}>{dive.competitor.heading}</MkHeading>
                  <p class="mt-3 text-(--mk-subtle)">{dive.competitor.body}</p>
                </MkCard>
              </div>
            </div>
          ))
        }
      </div>
    </MkSection>

    <MkSection tone="canvas" labelledby="compare-recommendation-title" width="narrow">
      <MkHeading level={2} id="compare-recommendation-title">Our recommendation</MkHeading>
      <p class="mt-6 text-pretty text-mk-lead text-(--mk-subtle)">{entry.recommendationCompetitor}</p>
      <p class="mt-4 text-pretty text-mk-lead">{text(entry.recommendationRareBooks)}</p>
      <MkCard class="mt-10 flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
        <div>
          <MkHeading level={3}>Switching from {shortName}?</MkHeading>
          <p class="mt-2 text-(--mk-subtle)">Read our step by step guide to moving your books.</p>
        </div>
        <MkButton href={`/alternatives/${slug}`} variant="secondary" class="max-sm:w-full md:shrink-0">
          Read the switching guide
        </MkButton>
      </MkCard>
    </MkSection>

    <HomeCta copy={cta} signedIn={signedIn} location="compare_page_footer" />
  </main>
  <MkFooter />
</Layout>

