---
// An /alternatives/<slug> switching guide (spec 0021 AC-11): six mk bands between MkNav and MkFooter, with
// the words from the spec's Page copy. The body varies by country and sign in state; the head never does.
import MkCard from "@components/marketing/MkCard.astro";
import MkFaq from "@components/marketing/MkFaq.astro";
import MkFooter from "@components/marketing/MkFooter.astro";
import MkHeading from "@components/marketing/MkHeading.astro";
import MkNav from "@components/marketing/MkNav.astro";
import MkSection from "@components/marketing/MkSection.astro";
import CompareHero from "@components/marketing/compare/CompareHero.astro";
import CompareTable from "@components/marketing/compare/CompareTable.astro";
import HomeCta from "@components/marketing/home/HomeCta.astro";
import Layout from "./Layout.astro";
import { AppConfig } from "../constants";
import { homeCopy } from "../constants/home.ts";
import { fillRareBooks, rareBooksRowsFor, rareBooksValues, type CompetitorEntry } from "../data/competitors.ts";
import { breadcrumbJsonLd } from "../lib/marketing/breadcrumb.ts";
import { escapeHtml } from "../lib/marketing/escapeHtml.ts";
import { fill } from "../lib/marketing/home.ts";

interface Props {
  entry: CompetitorEntry;
  local: boolean;
  signedIn: boolean;
}

const { entry, local, signedIn } = Astro.props;
const { shortName, slug } = entry;
const pageName = `${shortName} alternative`;
const text = (value: string) => fillRareBooks(value, local);
const values = { ...rareBooksValues(local), shortName, slug };
// MkFaq writes the answer with set:html, so our plain text answers are escaped first.
const faqs = entry.faqs.map((faq) => ({ question: text(faq.q), answer: escapeHtml(text(faq.a)) }));
const cta = {
  title: "Ready to make the *switch*?",
  lead: fill("Try every feature free for {freeDays} days, with no card needed.", values),
  primary: "Start free trial",
};
---

<Layout
  title={`Best ${shortName} Alternative for SMEs | RareBooks`}
  description={entry.metaDescription}
  canonicalPath={`/alternatives/${slug}`}
  ogImage="/og/home.jpg"
  ogImageAlt={homeCopy.abroad.hero.screenshotAlt}
  preloadSerif
  jsonLd={breadcrumbJsonLd(AppConfig.urls.rootUrl, "alternatives", slug, pageName)}
>
  <MkNav />
  <main id="main">
    <CompareHero
      section={{ name: "Alternatives", href: "/alternatives" }}
      pageName={pageName}
      overline="Switching guide"
      title={`Looking for an alternative to *${shortName}*?`}
      lead="Meet RareBooks: accounting, stock and point of sale in one app for small businesses, in any browser."
      location="alternatives_page_header"
      secondary={{ label: "See the full comparison", href: `/compare/${slug}` }}
      signedIn={signedIn}
    />

    <MkSection tone="tint" labelledby="alt-switch-title">
      <MkHeading level={2} id="alt-switch-title" align="center">Is it time to switch?</MkHeading>
      <div class="mx-auto mt-10 grid max-w-4xl gap-6 md:mt-12 md:grid-cols-2">
        <MkCard as="article" class="max-md:order-2">
          <MkHeading level={3}>When to choose {shortName}</MkHeading>
          <p class="mt-3 text-(--mk-subtle)">{entry.whenToChooseCompetitor}</p>
        </MkCard>
        <MkCard as="article" class="border-2 border-mk-brand max-md:order-1">
          <MkHeading level={3}>Why businesses switch to RareBooks</MkHeading>
          <p class="mt-3">{text(entry.whySwitchToRareBooks)}</p>
        </MkCard>
      </div>
    </MkSection>

    <MkSection tone="canvas" labelledby="alt-table-title">
      <MkHeading level={2} id="alt-table-title" align="center">Side by side</MkHeading>
      <p class="mx-auto mt-4 max-w-2xl text-center text-pretty text-mk-lead text-(--mk-subtle)">
        {fill("How RareBooks compares to {shortName} on what a small business uses every day.", values)}
      </p>
      <div class="mx-auto mt-10 max-w-4xl md:mt-12">
        <CompareTable shortName={shortName} rareBooks={rareBooksRowsFor(local)} competitor={entry.rows} />
      </div>
    </MkSection>

    <MkSection tone="tint" labelledby="alt-migration-title" width="narrow">
      <MkHeading level={2} id="alt-migration-title">Moving from {shortName} to RareBooks</MkHeading>
      <p class="mt-4 text-pretty text-mk-lead text-(--mk-subtle)">Moving your books over takes four steps.</p>
      <ol class="mt-10 space-y-6">
        {
          entry.migrationSteps.map((step, index) => (
            <li class="flex gap-4">
              <span
                aria-hidden="true"
                class="flex size-10 shrink-0 items-center justify-center rounded-full bg-mk-brand font-bold text-mk-on-dark"
              >
                {index + 1}
              </span>
              <p class="pt-2">{text(step)}</p>
            </li>
          ))
        }
      </ol>
    </MkSection>

    <MkSection tone="canvas" labelledby="alt-faq-title" width="narrow">
      <MkHeading level={2} id="alt-faq-title">Questions about switching</MkHeading>
      <MkFaq items={faqs} class="mt-8" />
    </MkSection>

    <HomeCta copy={cta} signedIn={signedIn} location="alternatives_page_footer" />
  </main>
  <MkFooter />
</Layout>

