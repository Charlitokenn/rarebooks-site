---
// Rendered on demand (spec 0018 AC-1), so an unknown URL goes through the Clerk middleware and the header
// shows the right buttons for the visitor.
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import MkNav from "@components/marketing/MkNav.astro";
import MkFooter from "@components/marketing/MkFooter.astro";
import MkSection from "@components/marketing/MkSection.astro";
import MkHeading from "@components/marketing/MkHeading.astro";
import MkButton from "@components/marketing/MkButton.astro";
import { AppConfig } from "../constants/index.ts";

Astro.response.status = 404;
---

<Layout title={`Page not found | ${AppConfig.appName}`} noindex>
  <MkNav />
  <main id="main">
    <MkSection width="narrow" labelledby="not-found">
      <div class="text-center">
        <MkHeading level={1} id="not-found" overline="404" align="center">Page not found</MkHeading>
        <p class="mt-4 text-mk-lead text-(--mk-subtle)">Check the address, or pick up from one of these.</p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <MkButton href="/">Go home</MkButton>
          <MkButton href={AppConfig.urls.docsHomePath} variant="secondary">View documentation</MkButton>
        </div>
      </div>
    </MkSection>
  </main>
  <MkFooter />
</Layout>
