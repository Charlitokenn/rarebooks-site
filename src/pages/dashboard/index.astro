---
import PortalLayout from "../../layouts/PortalLayout.astro";
import { PageHero } from "../../components/components/pageHero.tsx"
import { SiteStatus } from "../../components/onboarding/SiteStatus";
import { env } from "cloudflare:workers";

export const prerender = false;

const userDetails = await Astro.locals.currentUser();
const firstName = userDetails?.firstName;
// Spec 0014 AC-4: the user's hosted site, or the start form when they have none. The desktop license, device
// and renewal parts are retired (AC-7).
const turnstileSiteKey = env.PUBLIC_TURNSTILE_SITE_KEY || "";
---

<PortalLayout>
    <PageHero type="greeting" name={firstName} subtitle="Your RareBooks site" client:load/>
    <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
    <div class="py-6 px-4">
        <SiteStatus client:load turnstileSiteKey={turnstileSiteKey} />
    </div>
</PortalLayout>
