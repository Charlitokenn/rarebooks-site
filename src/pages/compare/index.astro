---
// /compare (spec 0021 AC-14): every competitor in `competitors`, in name order. Rendered per request so MkNav
// shows the right buttons for the visitor; the head is the same for everyone (AC-7).
import ContactUsModal from "@components/ContactUsModal.astro";
import MkFooter from "@components/marketing/MkFooter.astro";
import MkNav from "@components/marketing/MkNav.astro";
import CompareIndex from "@components/marketing/compare/CompareIndex.astro";
import Layout from "../../layouts/Layout.astro";
import { homeCopy } from "../../constants/home.ts";

export const prerender = false;

// The nav varies by sign in state, so the page never sits in a shared cache.
Astro.response.headers.set("Cache-Control", "private, no-cache");
---

<Layout
  title="Compare RareBooks to Other Accounting Software"
  description="See how RareBooks compares to Xero, QuickBooks, Sage, Zoho Books and other accounting software on price, features and fit."
  canonicalPath="/compare"
  ogImage="/og/home.jpg"
  ogImageAlt={homeCopy.abroad.hero.screenshotAlt}
  preloadSerif
>
  <MkNav />
  <main id="main">
    <CompareIndex
      section="compare"
      overline="Comparisons"
      title="Compare RareBooks to other *accounting* software"
      lead="Side by side breakdowns of price, features and fit, so you know exactly how RareBooks stacks up."
      cardHeading={(shortName) => `RareBooks vs ${shortName}`}
      cardLink="See the comparison"
      cross={{
        title: "Thinking of switching?",
        text: "Each guide covers when to stay, why businesses move and how to bring your books over.",
        button: "Read the switching guides",
        href: "/alternatives",
      }}
    />
  </main>
  <MkFooter />
</Layout>

<ContactUsModal id="contact-us-modal" title="Contact Us" />
