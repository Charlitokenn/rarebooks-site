---
import ContactUsModal from "@components/ContactUsModal.astro";
export const prerender = false;

import Navbar from "@components/Navbar.astro"
import Hero from "@components/Hero.astro"
import Comparison from "@components/Comparison.astro"
import HowItWorks from "@components/HowItWorks.astro"
import Stats from "@components/Stats.astro"
import Guarantee from "@components/Guarantee.astro"
import Pricing from "@components/Pricing.astro"
import CallToAction from "@components/CallToAction.astro"
import Footer from "@components/Footer.astro"
import Layout from "src/layouts/Layout.astro"
import TrialLicenseModal from "@components/TrialLicenseModal.astro";
---

<Layout>
    <Navbar />
    <main>
        <Hero />
        <Comparison />
        <!--<HowItWorks />-->
        <!--<Stats />-->
        <Guarantee />
        <Pricing />
        <CallToAction />
    </main>
    <Footer />
</Layout>

<!-- Modal instance -->
<TrialLicenseModal id="trial-modal" title="Start your free trial" />

<!-- Modal instance -->
<ContactUsModal id="contact-us-modal" title="Contact Us" />


<script is:inline>
    (function () {
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('[data-open-modal]');
            if (!btn) return;
            const modalId = btn.getAttribute('data-open-modal');
            const dialog = document.getElementById(modalId);
            if (dialog && typeof dialog.showModal === 'function') {
                dialog.showModal();
            }
        });
    })();
</script>