---
// /alternatives (spec 0021 AC-14): a switching guide for every competitor in `competitors`, in name order.
// Rendered per request so MkNav shows the right buttons for the visitor; the head is the same for everyone.
import MkFooter from "@components/marketing/MkFooter.astro";
import MkNav from "@components/marketing/MkNav.astro";
import CompareIndex from "@components/marketing/compare/CompareIndex.astro";
import Layout from "../../layouts/Layout.astro";
import { homeCopy } from "../../constants/home.ts";

export const prerender = false;

// The nav varies by sign in state, so the page never sits in a shared cache.
Astro.response.headers.set("Cache-Control", "private, no-cache");
---

<Layout
  title="RareBooks Alternatives Guides"
  description="Switching from QuickBooks, Xero, Wave or another accounting tool? See why businesses move to RareBooks and how to bring your books over."
  canonicalPath="/alternatives"
  ogImage="/og/home.jpg"
  ogImageAlt={homeCopy.abroad.hero.screenshotAlt}
  preloadSerif
>
  <MkNav />
  <main id="main">
    <CompareIndex
      section="alternatives"
      overline="Switching guides"
      title="Switching accounting *software*?"
      lead="See why businesses move to RareBooks, what to expect when you bring your books over, and answers to common switching questions."
      cardHeading={(shortName) => `${shortName} alternative`}
      cardLink="Read the guide"
      cross={{
        title: "Want the full comparison?",
        text: "Price, features and fit, side by side for every tool.",
        button: "See all comparisons",
        href: "/compare",
      }}
    />
  </main>
  <MkFooter />
</Layout>

