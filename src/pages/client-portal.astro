---
import Layout from "../layouts/PortalLayout.astro";
import { AppSidebar } from "../components/components/app-sidebar.tsx"
import { SidebarProvider, SidebarInset, SidebarTrigger } from "../components/components/ui/sidebar.tsx"
import { Show, UserButton, SignInButton, SignUpButton } from '@clerk/astro/components'
import React from "react";
import { AppConfig } from "../constants";
import { SignIn } from '@clerk/astro/components'
---

<Layout title="Client Portal">
    <Show when="signed-out">
        <SignIn />
    </Show>
    <Show when="signed-in">
        <SidebarProvider client:load>
            <AppSidebar/>
        </SidebarProvider>
    </Show>
</Layout>