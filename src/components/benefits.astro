---
interface StatItem {
    value: string;
    label: string;
}

interface Feature {
    tag: string;
    tagIcon: string;
    headline: string;
    accentWord: string;
    body: string;
    primaryCta: string;
    secondaryCta: string;
    imagePosition: "left" | "right";
    mockupType: "network" | "scheduler" | "content-mgmt" | "studio";
}

const features: Feature[] = [
    {
        tag: "Cross-Posting",
        tagIcon: "⚡",
        headline: "Post to all platforms",
        accentWord: "instantly",
        body: "Publish everywhere in 30 seconds, not 30 minutes. Manage all your personal and brand accounts without switching back and forth. Connect your social media accounts and publish your content across all platforms with a single click – no learning curve required.",
        primaryCta: "Start posting",
        secondaryCta: "View platforms",
        imagePosition: "right",
        mockupType: "network",
    },
    {
        tag: "Scheduling",
        tagIcon: "📅",
        headline: "Schedule posts",
        accentWord: "effortlessly",
        body: "Plan your content strategy ahead of time. Schedule posts across all platforms. Customize your posts perfectly per platform. Queue up your posts and let post bridge handle the rest.",
        primaryCta: "Start scheduling",
        secondaryCta: "View demo",
        imagePosition: "left",
        mockupType: "scheduler",
    },
    {
        tag: "Content Management",
        tagIcon: "⊞",
        headline: "Manage content",
        accentWord: "efficiently",
        body: "View all your scheduled and published posts in one place. Track what's been posted, edit upcoming posts, and stay on top of your content strategy.",
        primaryCta: "Get started",
        secondaryCta: "See pricing",
        imagePosition: "right",
        mockupType: "content-mgmt",
    },
    {
        tag: "Content Studio",
        tagIcon: "✏️",
        headline: "Create videos",
        accentWord: "easily",
        body: "Proven templates to quickly create videos for your brand. Basic drag-and-drop editor to customize for your needs.",
        primaryCta: "Try studio",
        secondaryCta: "View Examples",
        imagePosition: "left",
        mockupType: "studio",
    },
];

const stats: StatItem[] = [
    { value: "9", label: "Social Platforms Supported" },
    { value: "1,509,507", label: "Posts Published by Users" },
    { value: "2 min", label: "Average Time to Post Everywhere" },
];
---

<section class="mt-18 bg-white dark:bg-zinc-900" aria-label="Platform features">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 flex flex-col gap-[clamp(64px,8vw,120px)]">

        {features.map((f) => (
                <article class="feature-row grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-20 items-center" aria-label={f.tag}>
                    <div class={`flex flex-col justify-center ${f.imagePosition === 'left' ? 'md:order-2' : ''}`}>
                        <p class="inline-flex items-center gap-2 text-accent-600 dark:text-accent-400 text-xs font-semibold tracking-widest uppercase mb-3">
                            <span aria-hidden="true">{f.tagIcon}</span>
                            {f.tag}
                        </p>
                        <h2 class="text-3xl md:text-4xl lg:text-[2.75rem] font-bold text-gray-900 dark:text-gray-50 tracking-tight leading-[1.1] mb-4">
                            {f.headline}{" "}
                            <span class="text-accent-600 dark:text-accent-400">{f.accentWord}</span>
                        </h2>
                        <p class="text-base md:text-lg text-gray-500 dark:text-gray-400 leading-[1.7] max-w-[42ch] mb-7">
                            {f.body}
                        </p>
                        <div class="flex items-center gap-3 flex-wrap">
                            <a href="#" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-accent-600 hover:bg-accent-700 dark:bg-accent-600 dark:hover:bg-accent-500 text-white text-sm font-semibold transition-all duration-200 hover:-translate-y-0.5 shadow-[0_2px_12px_rgba(99,102,241,0.35)] hover:shadow-[0_4px_20px_rgba(99,102,241,0.45)]">
                                {f.primaryCta}
                                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                                    <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </a>
                            <a href="#" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-gray-200 dark:border-gray-700 text-gray-900 dark:text-gray-100 text-sm font-semibold hover:border-gray-300 dark:hover:border-gray-600 transition-all duration-200">
                                {f.secondaryCta}
                            </a>
                        </div>
                    </div>

                    <div class={`flex items-center justify-center ${f.imagePosition === 'left' ? 'md:order-1' : ''}`}>
                        <div class="w-full max-w-[480px] rounded-[18px] bg-gray-50 dark:bg-gray-900 border border-gray-200 dark:border-gray-800 shadow-[0_2px_24px_0_rgba(15,23,42,.07)] dark:shadow-[0_2px_24px_0_rgba(0,0,0,.3)] overflow-hidden" aria-hidden="true">

                            {f.mockupType === "network" && (
                                    <div class="mockup-network">
                                        <svg viewBox="0 0 360 280" xmlns="http://www.w3.org/2000/svg" class="network-svg">
                                            <line x1="120" y1="140" x2="190" y2="140" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <line x1="220" y1="140" x2="280" y2="56"  stroke="#e2e8f0" stroke-width="1.5"/>
                                            <line x1="220" y1="140" x2="280" y2="98"  stroke="#e2e8f0" stroke-width="1.5"/>
                                            <line x1="220" y1="140" x2="280" y2="140" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <line x1="220" y1="140" x2="280" y2="182" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <line x1="220" y1="140" x2="280" y2="224" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <circle cx="100" cy="140" r="26" fill="white" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <text x="100" y="145" text-anchor="middle" font-size="18" fill="#94a3b8">👤</text>
                                            <circle cx="205" cy="140" r="26" fill="white" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <path d="M196 133 a9 9 0 0 1 18 0 v14 a9 9 0 0 1-18 0z" fill="#6366f1" opacity="0.15"/>
                                            <circle cx="205" cy="140" r="7" fill="#6366f1"/>
                                            <circle cx="300" cy="56" r="22" fill="white" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <text x="300" y="63" text-anchor="middle" font-size="16" fill="#1877f2">f</text>
                                            <circle cx="300" cy="98" r="22" fill="white" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <rect x="291" y="89" width="18" height="18" rx="5" fill="none" stroke="#e1306c" stroke-width="1.5"/>
                                            <circle cx="300" cy="98" r="4.5" fill="none" stroke="#e1306c" stroke-width="1.5"/>
                                            <circle cx="300" cy="140" r="22" fill="white" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <text x="300" y="146" text-anchor="middle" font-size="14" font-weight="700" fill="#0f172a">𝕏</text>
                                            <circle cx="300" cy="182" r="22" fill="white" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <text x="300" y="188" text-anchor="middle" font-size="14" font-weight="700" fill="#0a66c2">in</text>
                                            <circle cx="300" cy="224" r="22" fill="white" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <text x="300" y="230" text-anchor="middle" font-size="14" fill="#0f172a">♪</text>
                                        </svg>
                                    </div>
                            )}

                            {f.mockupType === "scheduler" && (
                                    <div class="mockup-window">
                                        <div class="mockup-window__bar">
                                            <span class="mockup-window__dot"></span>
                                            <span class="mockup-window__dot"></span>
                                            <span class="mockup-window__dot"></span>
                                            <div class="mockup-window__title">Review &amp; Publish</div>
                                        </div>
                                        <div class="mockup-window__body">
                                            <div class="mock-field">
                                                <div class="mock-field__label">Caption</div>
                                                <div class="mock-field__input mock-field__input--short"></div>
                                            </div>
                                            <div class="mock-field">
                                                <div class="mock-field__label">Publishing to</div>
                                                <div class="mock-account-list">
                                                    {["Instagram", "TikTok", "Threads", "Pinterest", "Twitter / X", "YouTube"].map((platform) => (
                                                            <div class="mock-account">
                                                                <div class="mock-account__avatar"></div>
                                                                <span class="mock-account__name">{platform}</span>
                                                                <div class="mock-account__user"></div>
                                                            </div>
                                                    ))}
                                                </div>
                                            </div>
                                            <div class="mock-calendar-popup">
                                                <div class="mock-cal-header">
                                                    <div class="mock-cal-tabs">
                                                        <span class="mock-cal-tab">03</span>
                                                        <span class="mock-cal-tab">04</span>
                                                        <span class="mock-cal-tab mock-cal-tab--active">AM</span>
                                                    </div>
                                                    <div class="mock-cal-grid">
                                                        {Array.from({length: 6}, (_, i) => (
                                                                <span class="mock-cal-cell">{String(i + 1).padStart(2, "0")}</span>
                                                        ))}
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="mock-schedule-row">
                                                <div class="mock-dot mock-dot--green"></div>
                                                <div class="mock-bar mock-bar--date"></div>
                                            </div>
                                        </div>
                                    </div>
                            )}

                            {f.mockupType === "content-mgmt" && (
                                    <div class="mockup-window mockup-window--dark">
                                        <div class="mockup-window__bar mockup-window__bar--dark">
                                            <span class="mockup-window__dot"></span>
                                            <span class="mockup-window__dot"></span>
                                            <span class="mockup-window__dot"></span>
                                            <div class="mockup-window__title" style="color:var(--color-gray-400)">Scheduled Posts</div>
                                        </div>
                                        <div class="mockup-window__body">
                                            <div class="mock-posts-header">
                                                <div class="mock-col-head">Select Accounts to view per platform</div>
                                            </div>
                                            <div class="mock-posts-grid">
                                                {["Tweets", "jack fries", "Curiosity Quench", "jack fries", "Youtube", "premsa", "jack14", "Shopify", "jack fries", "postbridge"].map((name, i) => (
                                                        <div class={`mock-post-item ${i === 3 ? "mock-post-item--highlight" : ""}`}>
                                                            <div class="mock-post-avatar"></div>
                                                            <span class="mock-post-name">{name}</span>
                                                        </div>
                                                ))}
                                            </div>
                                            <div class="mock-delete-btn">Delete</div>
                                        </div>
                                    </div>
                            )}

                            {f.mockupType === "studio" && (
                                    <div class="mockup-window">
                                        <div class="mockup-window__bar">
                                            <span class="mockup-window__dot"></span>
                                            <span class="mockup-window__dot"></span>
                                            <span class="mockup-window__dot"></span>
                                            <div class="mockup-window__title">Content Studio</div>
                                        </div>
                                        <div class="mockup-window__body">
                                            <div class="mock-studio-tag">
                                                <span class="mock-tag mock-tag--green">AI</span>
                                                <span class="mock-tag mock-tag--gray">Threads</span>
                                            </div>
                                            <div class="mock-studio-hero">
                                                <div class="mock-studio-icon">▶</div>
                                                <div class="mock-studio-copy">
                                                    <div class="mock-studio-title">AI UGC Video Creator</div>
                                                    <div class="mock-studio-desc"></div>
                                                    <div class="mock-studio-desc mock-studio-desc--short"></div>
                                                </div>
                                                <div class="mock-btn-pill">Try AI UGC →</div>
                                            </div>
                                            <div class="mock-template-grid">
                                                {[
                                                    { name: "2×2 Grid Video", stat: "20M+ views" },
                                                    { name: "Single Fade-In Video", stat: "1B+ views" },
                                                    { name: "AI UGC Creator", stat: "5M+ views" },
                                                ].map((tpl) => (
                                                        <div class="mock-template-card">
                                                            <div class="mock-template-thumb"></div>
                                                            <div class="mock-template-name">{tpl.name}</div>
                                                            <div class="mock-template-stat">{tpl.stat}</div>
                                                            <div class="mock-btn-sm">Use Template</div>
                                                        </div>
                                                ))}
                                            </div>
                                        </div>
                                    </div>
                            )}

                        </div>
                    </div>
                </article>
        ))}

        <div class="stats-bar flex items-center justify-around flex-wrap gap-0 border border-gray-200 dark:border-gray-800 rounded-[18px] px-6 md:px-10 py-8 md:py-12 bg-gray-50 dark:bg-gray-900/50" role="region" aria-label="Platform statistics">
            {stats.map((s, i) => (
                    <>
                        <div class="flex flex-col items-center gap-1.5 flex-1 min-w-[140px]">
                            <span class="text-[clamp(1.8rem,4vw,3rem)] font-bold text-gray-900 dark:text-gray-50 tracking-tighter leading-none">{s.value}</span>
                            <span class="text-xs font-semibold uppercase tracking-widest text-gray-500 dark:text-gray-400 text-center">{s.label}</span>
                        </div>
                        {i < stats.length - 1 && <div class="hidden sm:block w-px h-14 bg-gray-200 dark:bg-gray-700" aria-hidden="true"></div>}
                    </>
            ))}
        </div>

    </div>
</section>

<style>
    .mockup-network { padding: 24px; min-height: 240px; display: flex; align-items: center; justify-content: center; }
    .network-svg { width: 100%; height: auto; max-height: 240px; }

    .mockup-window { border-radius: 18px; overflow: hidden; }

    .mockup-window__bar {
        display: flex; align-items: center; gap: 6px; padding: 10px 14px;
        background: var(--color-gray-100); border-bottom: 1px solid var(--color-gray-200);
    }
    :global(.dark) .mockup-window__bar {
        background: var(--color-gray-800); border-color: var(--color-gray-700);
    }

    .mockup-window__bar--dark {
        background: var(--color-gray-800); border-color: var(--color-gray-700);
    }
    :global(.dark) .mockup-window__bar--dark {
        background: var(--color-gray-950); border-color: var(--color-gray-800);
    }

    .mockup-window__dot {
        width: 9px; height: 9px; border-radius: 50%; background: var(--color-gray-300); flex-shrink: 0;
    }
    .mockup-window__dot:nth-child(1) { background: #f87171; }
    .mockup-window__dot:nth-child(2) { background: #fbbf24; }
    .mockup-window__dot:nth-child(3) { background: #4ade80; }

    .mockup-window__title {
        margin-left: 8px; font-size: 0.72rem; font-weight: 600;
        color: var(--color-gray-500); letter-spacing: 0.01em;
    }
    :global(.dark) .mockup-window__title {
        color: var(--color-gray-400);
    }

    .mockup-window__body { padding: 14px 16px 16px; }

    .mock-field { margin-bottom: 10px; }
    .mock-field__label {
        font-size: 0.65rem; font-weight: 600; color: var(--color-gray-500);
        margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.06em;
    }
    :global(.dark) .mock-field__label { color: var(--color-gray-400); }

    .mock-field__input {
        height: 22px; background: var(--color-gray-200); border-radius: 4px;
    }
    :global(.dark) .mock-field__input { background: var(--color-gray-700); }
    .mock-field__input--short { width: 60%; }

    .mock-account-list { display: flex; flex-direction: column; gap: 5px; }
    .mock-account {
        display: flex; align-items: center; gap: 8px;
        font-size: 0.65rem; color: var(--color-gray-500);
    }
    :global(.dark) .mock-account { color: var(--color-gray-400); }

    .mock-account__avatar {
        width: 18px; height: 18px; border-radius: 50%;
        background: linear-gradient(135deg, var(--color-accent-100), var(--color-accent-500));
        flex-shrink: 0;
    }
    :global(.dark) .mock-account__avatar {
        background: linear-gradient(135deg, var(--color-accent-900), var(--color-accent-600));
    }

    .mock-account__name { flex: 1; font-size: 0.65rem; color: var(--color-gray-900); font-weight: 500; }
    :global(.dark) .mock-account__name { color: var(--color-gray-100); }

    .mock-account__user {
        width: 50px; height: 8px;
        background: var(--color-gray-200); border-radius: 3px;
    }
    :global(.dark) .mock-account__user { background: var(--color-gray-700); }

    .mock-calendar-popup {
        background: white; border: 1px solid var(--color-gray-200);
        border-radius: 8px; padding: 8px; margin: 8px 0;
        box-shadow: 0 4px 12px rgba(0,0,0,.08); width: fit-content;
    }
    :global(.dark) .mock-calendar-popup {
        background: var(--color-gray-900); border-color: var(--color-gray-700);
        box-shadow: 0 4px 12px rgba(0,0,0,.3);
    }

    .mock-cal-tabs { display: flex; gap: 4px; margin-bottom: 6px; }
    .mock-cal-tab {
        padding: 2px 8px; border-radius: 4px;
        font-size: 0.6rem; font-weight: 600;
        background: var(--color-gray-100); color: var(--color-gray-500);
    }
    :global(.dark) .mock-cal-tab { background: var(--color-gray-800); color: var(--color-gray-400); }

    .mock-cal-tab--active { background: var(--color-accent-500); color: white; }
    :global(.dark) .mock-cal-tab--active { background: var(--color-accent-600); }

    .mock-cal-grid {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px;
    }
    .mock-cal-cell {
        padding: 3px 6px; font-size: 0.6rem; text-align: center;
        color: var(--color-gray-500); border-radius: 3px;
        background: var(--color-gray-50);
    }
    :global(.dark) .mock-cal-cell { background: var(--color-gray-800); color: var(--color-gray-400); }

    .mock-schedule-row {
        display: flex; align-items: center; gap: 8px; margin-top: 8px;
    }
    .mock-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .mock-dot--green { background: var(--color-accent-500); }
    .mock-bar { height: 8px; border-radius: 3px; background: var(--color-gray-200); }
    :global(.dark) .mock-bar { background: var(--color-gray-700); }
    .mock-bar--date { width: 80px; }

    .mockup-window--dark { background: var(--color-gray-900); }
    :global(.dark) .mockup-window--dark { background: var(--color-gray-950); }
    .mockup-window--dark .mockup-window__body { background: var(--color-gray-900); }
    :global(.dark) .mockup-window--dark .mockup-window__body { background: var(--color-gray-950); }

    .mock-posts-header {
        font-size: 0.6rem; color: var(--color-gray-400);
        padding-bottom: 6px; border-bottom: 1px solid var(--color-gray-800);
        margin-bottom: 8px;
    }
    :global(.dark) .mock-posts-header { color: var(--color-gray-500); border-color: var(--color-gray-800); }

    .mock-posts-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 4px;
    }
    .mock-post-item {
        display: flex; align-items: center; gap: 6px;
        padding: 5px 7px; border-radius: 6px;
        background: var(--color-gray-800);
    }
    :global(.dark) .mock-post-item { background: var(--color-gray-800); }
    .mock-post-item--highlight { background: var(--color-accent-900); }
    :global(.dark) .mock-post-item--highlight { background: var(--color-accent-900); }

    .mock-post-avatar {
        width: 16px; height: 16px; border-radius: 50%;
        background: var(--color-gray-600); flex-shrink: 0;
    }
    :global(.dark) .mock-post-avatar { background: var(--color-gray-700); }

    .mock-post-name { font-size: 0.58rem; color: var(--color-gray-400); font-weight: 500; }
    :global(.dark) .mock-post-name { color: var(--color-gray-400); }

    .mock-delete-btn {
        margin-top: 10px; width: fit-content;
        background: #ef4444; color: white;
        font-size: 0.6rem; font-weight: 600;
        padding: 4px 10px; border-radius: 4px;
    }

    .mock-studio-tag { display: flex; gap: 6px; margin-bottom: 10px; }
    .mock-tag {
        font-size: 0.6rem; font-weight: 700;
        padding: 2px 8px; border-radius: 999px;
    }
    .mock-tag--green { background: var(--color-accent-100); color: var(--color-accent-700); }
    :global(.dark) .mock-tag--green { background: var(--color-accent-900); color: var(--color-accent-400); }

    .mock-tag--gray { background: var(--color-gray-100); color: var(--color-gray-500); }
    :global(.dark) .mock-tag--gray { background: var(--color-gray-800); color: var(--color-gray-400); }

    .mock-studio-hero {
        display: flex; align-items: flex-start; gap: 10px;
        padding: 10px; background: white;
        border: 1px solid var(--color-gray-200);
        border-radius: 8px; margin-bottom: 10px;
    }
    :global(.dark) .mock-studio-hero {
        background: var(--color-gray-900); border-color: var(--color-gray-700);
    }

    .mock-studio-icon {
        width: 32px; height: 32px; border-radius: 6px;
        background: var(--color-accent-100); color: var(--color-accent-600);
        font-size: 12px; display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    :global(.dark) .mock-studio-icon {
        background: var(--color-accent-900); color: var(--color-accent-400);
    }

    .mock-studio-copy { flex: 1; }
    .mock-studio-title { font-size: 0.65rem; font-weight: 700; color: var(--color-gray-900); margin-bottom: 4px; }
    :global(.dark) .mock-studio-title { color: var(--color-gray-100); }

    .mock-studio-desc {
        height: 6px; background: var(--color-gray-200);
        border-radius: 3px; margin-bottom: 3px; width: 90%;
    }
    :global(.dark) .mock-studio-desc { background: var(--color-gray-700); }
    .mock-studio-desc--short { width: 60%; }

    .mock-btn-pill {
        font-size: 0.58rem; font-weight: 600;
        background: var(--color-accent-500); color: white;
        padding: 4px 8px; border-radius: 999px;
        white-space: nowrap; align-self: center;
    }
    :global(.dark) .mock-btn-pill { background: var(--color-accent-600); }

    .mock-template-grid {
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px;
    }
    .mock-template-card {
        background: white; border: 1px solid var(--color-gray-200);
        border-radius: 8px; padding: 8px;
        display: flex; flex-direction: column; gap: 4px;
    }
    :global(.dark) .mock-template-card {
        background: var(--color-gray-900); border-color: var(--color-gray-700);
    }

    .mock-template-thumb {
        height: 48px;
        background: linear-gradient(135deg, var(--color-gray-100), var(--color-accent-100));
        border-radius: 5px; margin-bottom: 2px;
    }
    :global(.dark) .mock-template-thumb {
        background: linear-gradient(135deg, var(--color-gray-800), var(--color-accent-900));
    }

    .mock-template-name { font-size: 0.58rem; font-weight: 600; color: var(--color-gray-900); }
    :global(.dark) .mock-template-name { color: var(--color-gray-100); }

    .mock-template-stat { font-size: 0.55rem; color: var(--color-gray-500); }
    :global(.dark) .mock-template-stat { color: var(--color-gray-400); }

    .mock-btn-sm {
        margin-top: 2px; font-size: 0.55rem; font-weight: 600;
        color: var(--color-accent-600); text-align: center;
        background: var(--color-accent-100);
        padding: 3px 6px; border-radius: 4px;
    }
    :global(.dark) .mock-btn-sm {
        color: var(--color-accent-400); background: var(--color-accent-900);
    }

    @media (prefers-reduced-motion: no-preference) {
        .feature-row {
            opacity: 0;
            transform: translateY(28px);
            transition: opacity 0.55s ease, transform 0.55s ease;
        }
        .feature-row.is-visible {
            opacity: 1;
            transform: none;
        }
        .stats-bar {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.5s ease 0.1s, transform 0.5s ease 0.1s;
        }
        .stats-bar.is-visible { opacity: 1; transform: none; }
    }
</style>

<script>
    const targets = document.querySelectorAll(".feature-row, .stats-bar");
    if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
            (entries) => {
                entries.forEach((e) => {
                    if (e.isIntersecting) {
                        e.target.classList.add("is-visible");
                        io.unobserve(e.target);
                    }
                });
            },
            { threshold: 0.12 }
        );
        targets.forEach((el) => io.observe(el));
    } else {
        targets.forEach((el) => el.classList.add("is-visible"));
    }
</script>