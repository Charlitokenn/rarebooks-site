---
// FeaturesSection.astro
// Social media management platform — features showcase component
// Astro best practices: scoped styles, semantic HTML, no unnecessary JS, CSS custom props

interface StatItem {
    value: string;
    label: string;
}

interface Feature {
    tag: string;
    tagIcon: string;
    headline: string;
    accentWord: string;
    body: string;
    primaryCta: string;
    secondaryCta: string;
    imagePosition: "left" | "right";
    mockupType: "network" | "scheduler" | "content-mgmt" | "studio";
}

const features: Feature[] = [
    {
        tag: "Cross-Posting",
        tagIcon: "⚡",
        headline: "Post to all platforms",
        accentWord: "instantly",
        body: "Publish everywhere in 30 seconds, not 30 minutes. Manage all your personal and brand accounts without switching back and forth. Connect your social media accounts and publish your content across all platforms with a single click – no learning curve required.",
        primaryCta: "Start posting",
        secondaryCta: "View platforms",
        imagePosition: "right",
        mockupType: "network",
    },
    {
        tag: "Scheduling",
        tagIcon: "📅",
        headline: "Schedule posts",
        accentWord: "effortlessly",
        body: "Plan your content strategy ahead of time. Schedule posts across all platforms. Customize your posts perfectly per platform. Queue up your posts and let post bridge handle the rest.",
        primaryCta: "Start scheduling",
        secondaryCta: "View demo",
        imagePosition: "left",
        mockupType: "scheduler",
    },
    {
        tag: "Content Management",
        tagIcon: "⊞",
        headline: "Manage content",
        accentWord: "efficiently",
        body: "View all your scheduled and published posts in one place. Track what's been posted, edit upcoming posts, and stay on top of your content strategy.",
        primaryCta: "Get started",
        secondaryCta: "See pricing",
        imagePosition: "right",
        mockupType: "content-mgmt",
    },
    {
        tag: "Content Studio",
        tagIcon: "✏️",
        headline: "Create videos",
        accentWord: "easily",
        body: "Proven templates to quickly create videos for your brand. Basic drag-and-drop editor to customize for your needs.",
        primaryCta: "Try studio",
        secondaryCta: "View Examples",
        imagePosition: "left",
        mockupType: "studio",
    },
];

const stats: StatItem[] = [
    { value: "9", label: "Social Platforms Supported" },
    { value: "1,509,507", label: "Posts Published by Users" },
    { value: "2 min", label: "Average Time to Post Everywhere" },
];
---

<section class="features-root mt-18" aria-label="Platform features">
    <div class="features-wrapper">

        {features.map((f) => (
                <article
                        class={`feature-row feature-row--${f.imagePosition}`}
                        aria-label={f.tag}
                >
                    <!-- Text column -->
                    <div class="feature-text">
                        <p class="feature-tag">
                            <span class="feature-tag__icon" aria-hidden="true">{f.tagIcon}</span>
                            {f.tag}
                        </p>
                        <h2 class="feature-heading">
                            {f.headline}{" "}
                            <span class="feature-heading__accent">{f.accentWord}</span>
                        </h2>
                        <p class="feature-body">{f.body}</p>
                        <div class="feature-ctas">
                            <a href="#" class="btn btn--primary">
                                {f.primaryCta}
                                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                                    <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg>
                            </a>
                            <a href="#" class="btn btn--ghost">{f.secondaryCta}</a>
                        </div>
                    </div>

                    <!-- Visual / Mockup column -->
                    <div class="feature-visual">
                        <div class={`mockup mockup--${f.mockupType}`} aria-hidden="true">

                            {f.mockupType === "network" && (
                                    <div class="mockup-network">
                                        <svg viewBox="0 0 360 280" xmlns="http://www.w3.org/2000/svg" class="network-svg">
                                            <!-- Connection lines -->
                                            <line x1="120" y1="140" x2="190" y2="140" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <line x1="220" y1="140" x2="280" y2="56"  stroke="#e2e8f0" stroke-width="1.5"/>
                                            <line x1="220" y1="140" x2="280" y2="98"  stroke="#e2e8f0" stroke-width="1.5"/>
                                            <line x1="220" y1="140" x2="280" y2="140" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <line x1="220" y1="140" x2="280" y2="182" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <line x1="220" y1="140" x2="280" y2="224" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <!-- User node -->
                                            <circle cx="100" cy="140" r="26" fill="white" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <text x="100" y="145" text-anchor="middle" font-size="18" fill="#94a3b8">👤</text>
                                            <!-- Hub node -->
                                            <circle cx="205" cy="140" r="26" fill="white" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <path d="M196 133 a9 9 0 0 1 18 0 v14 a9 9 0 0 1-18 0z" fill="#22c55e" opacity="0.15"/>
                                            <circle cx="205" cy="140" r="7" fill="#22c55e"/>
                                            <!-- Social platform nodes -->
                                            <!-- Facebook -->
                                            <circle cx="300" cy="56" r="22" fill="white" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <text x="300" y="63" text-anchor="middle" font-size="16" fill="#1877f2">f</text>
                                            <!-- Instagram -->
                                            <circle cx="300" cy="98" r="22" fill="white" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <rect x="291" y="89" width="18" height="18" rx="5" fill="none" stroke="#e1306c" stroke-width="1.5"/>
                                            <circle cx="300" cy="98" r="4.5" fill="none" stroke="#e1306c" stroke-width="1.5"/>
                                            <!-- X/Twitter -->
                                            <circle cx="300" cy="140" r="22" fill="white" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <text x="300" y="146" text-anchor="middle" font-size="14" font-weight="700" fill="#0f172a">𝕏</text>
                                            <!-- LinkedIn -->
                                            <circle cx="300" cy="182" r="22" fill="white" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <text x="300" y="188" text-anchor="middle" font-size="14" font-weight="700" fill="#0a66c2">in</text>
                                            <!-- TikTok -->
                                            <circle cx="300" cy="224" r="22" fill="white" stroke="#e2e8f0" stroke-width="1.5"/>
                                            <text x="300" y="230" text-anchor="middle" font-size="14" fill="#0f172a">♪</text>
                                        </svg>
                                    </div>
                            )}

                            {f.mockupType === "scheduler" && (
                                    <div class="mockup-window">
                                        <div class="mockup-window__bar">
                                            <span class="mockup-window__dot"></span>
                                            <span class="mockup-window__dot"></span>
                                            <span class="mockup-window__dot"></span>
                                            <div class="mockup-window__title">Review &amp; Publish</div>
                                        </div>
                                        <div class="mockup-window__body">
                                            <div class="mock-field">
                                                <div class="mock-field__label">Caption</div>
                                                <div class="mock-field__input mock-field__input--short"></div>
                                            </div>
                                            <div class="mock-field">
                                                <div class="mock-field__label">Publishing to</div>
                                                <div class="mock-account-list">
                                                    {["Instagram", "TikTok", "Threads", "Pinterest", "Twitter / X", "YouTube"].map((platform) => (
                                                            <div class="mock-account">
                                                                <div class="mock-account__avatar"></div>
                                                                <span class="mock-account__name">{platform}</span>
                                                                <div class="mock-account__user"></div>
                                                            </div>
                                                    ))}
                                                </div>
                                            </div>
                                            <div class="mock-calendar-popup">
                                                <div class="mock-cal-header">
                                                    <div class="mock-cal-tabs">
                                                        <span class="mock-cal-tab">03</span>
                                                        <span class="mock-cal-tab">04</span>
                                                        <span class="mock-cal-tab mock-cal-tab--active">AM</span>
                                                    </div>
                                                    <div class="mock-cal-grid">
                                                        {Array.from({length: 6}, (_, i) => (
                                                                <span class="mock-cal-cell">{String(i + 1).padStart(2, "0")}</span>
                                                        ))}
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="mock-schedule-row">
                                                <div class="mock-dot mock-dot--green"></div>
                                                <div class="mock-bar mock-bar--date"></div>
                                            </div>
                                        </div>
                                    </div>
                            )}

                            {f.mockupType === "content-mgmt" && (
                                    <div class="mockup-window mockup-window--dark">
                                        <div class="mockup-window__bar mockup-window__bar--dark">
                                            <span class="mockup-window__dot"></span>
                                            <span class="mockup-window__dot"></span>
                                            <span class="mockup-window__dot"></span>
                                            <div class="mockup-window__title" style="color:#94a3b8">Scheduled Posts</div>
                                        </div>
                                        <div class="mockup-window__body">
                                            <div class="mock-posts-header">
                                                <div class="mock-col-head">Select Accounts to view per platform</div>
                                            </div>
                                            <div class="mock-posts-grid">
                                                {["Tweets", "jack fries", "Curiosity Quench", "jack fries", "Youtube", "premsa", "jack14", "Shopify", "jack fries", "postbridge"].map((name, i) => (
                                                        <div class={`mock-post-item ${i === 3 ? "mock-post-item--highlight" : ""}`}>
                                                            <div class="mock-post-avatar"></div>
                                                            <span class="mock-post-name">{name}</span>
                                                        </div>
                                                ))}
                                            </div>
                                            <div class="mock-delete-btn">Delete</div>
                                        </div>
                                    </div>
                            )}

                            {f.mockupType === "studio" && (
                                    <div class="mockup-window">
                                        <div class="mockup-window__bar">
                                            <span class="mockup-window__dot"></span>
                                            <span class="mockup-window__dot"></span>
                                            <span class="mockup-window__dot"></span>
                                            <div class="mockup-window__title">Content Studio</div>
                                        </div>
                                        <div class="mockup-window__body">
                                            <div class="mock-studio-tag">
                                                <span class="mock-tag mock-tag--green">AI</span>
                                                <span class="mock-tag mock-tag--gray">Threads</span>
                                            </div>
                                            <div class="mock-studio-hero">
                                                <div class="mock-studio-icon">▶</div>
                                                <div class="mock-studio-copy">
                                                    <div class="mock-studio-title">AI UGC Video Creator</div>
                                                    <div class="mock-studio-desc"></div>
                                                    <div class="mock-studio-desc mock-studio-desc--short"></div>
                                                </div>
                                                <div class="mock-btn-pill">Try AI UGC →</div>
                                            </div>
                                            <div class="mock-template-grid">
                                                {[
                                                    { name: "2×2 Grid Video", stat: "20M+ views" },
                                                    { name: "Single Fade-In Video", stat: "1B+ views" },
                                                    { name: "AI UGC Creator", stat: "5M+ views" },
                                                ].map((tpl) => (
                                                        <div class="mock-template-card">
                                                            <div class="mock-template-thumb"></div>
                                                            <div class="mock-template-name">{tpl.name}</div>
                                                            <div class="mock-template-stat">{tpl.stat}</div>
                                                            <div class="mock-btn-sm">Use Template</div>
                                                        </div>
                                                ))}
                                            </div>
                                        </div>
                                    </div>
                            )}

                        </div>
                    </div>
                </article>
        ))}

        <!-- Stats bar -->
        <div class="stats-bar" role="region" aria-label="Platform statistics">
            {stats.map((s, i) => (
                    <>
                        <div class="stat-item">
                            <span class="stat-item__value">{s.value}</span>
                            <span class="stat-item__label">{s.label}</span>
                        </div>
                        {i < stats.length - 1 && <div class="stat-divider" aria-hidden="true"></div>}
                    </>
            ))}
        </div>

    </div>
</section>

<style>
    /* ─── Tokens ─────────────────────────────────────────────────── */
    .features-root {
        --green:        #22c55e;
        --green-dim:    #16a34a;
        --green-muted:  #dcfce7;
        --ink:          #0f172a;
        --ink-muted:    #475569;
        --border:       #e2e8f0;
        --bg:           #ffffff;
        --bg-card:      #f8fafc;
        --radius-card:  18px;
        --radius-btn:   999px;
        --shadow-card:  0 2px 24px 0 rgba(15,23,42,.07);
        --font-display: "DM Sans", "Outfit", system-ui, sans-serif;
        --font-body:    "DM Sans", system-ui, sans-serif;
        --section-gap:  clamp(64px, 8vw, 120px);

        background: var(--bg);
        font-family: var(--font-body);
        color: var(--ink);
    }

    /* ─── Layout ─────────────────────────────────────────────────── */
    .features-wrapper {
        max-width: 100%;
        margin: 0 auto;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--section-gap);
    }

    /* Feature row: alternating image-left / image-right */
    .feature-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: clamp(32px, 5vw, 80px);
        align-items: center;
    }

    .feature-row--right .feature-text  { order: 1; }
    .feature-row--right .feature-visual { order: 2; }
    .feature-row--left  .feature-text  { order: 2; }
    .feature-row--left  .feature-visual { order: 1; }

    @media (max-width: 768px) {
        .feature-row {
            grid-template-columns: 1fr;
            gap: 32px;
        }
        .feature-row--right .feature-text,
        .feature-row--right .feature-visual,
        .feature-row--left  .feature-text,
        .feature-row--left  .feature-visual { order: unset; }
    }

    /* ─── Feature text ───────────────────────────────────────────── */
    .feature-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--green);
        margin: 0 0 14px;
    }
    .feature-tag__icon { font-style: normal; font-size: 0.9rem; }

    .feature-heading {
        font-family: var(--font-display);
        font-size: clamp(2rem, 3.5vw, 2.75rem);
        font-weight: 700;
        line-height: 1.1;
        letter-spacing: -0.02em;
        margin: 0 0 18px;
        color: var(--ink);
    }
    .feature-heading__accent { color: var(--green); }

    .feature-body {
        font-size: clamp(0.9rem, 1.2vw, 1rem);
        line-height: 1.7;
        color: var(--ink-muted);
        margin: 0 0 28px;
        max-width: 42ch;
    }

    /* ─── Buttons ────────────────────────────────────────────────── */
    .feature-ctas {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 10px 20px;
        border-radius: var(--radius-btn);
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        transition: opacity 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease;
        cursor: pointer;
    }
    .btn:hover { opacity: 0.88; transform: translateY(-1px); }
    .btn:active { transform: translateY(0); }

    .btn--primary {
        background: var(--green);
        color: #fff;
        box-shadow: 0 2px 12px rgba(34,197,94,.35);
    }
    .btn--primary:hover { box-shadow: 0 4px 20px rgba(34,197,94,.45); }

    .btn--ghost {
        background: transparent;
        color: var(--ink);
        border: 1.5px solid var(--border);
    }
    .btn--ghost:hover { border-color: var(--ink-muted); }

    /* ─── Mockup wrapper ─────────────────────────────────────────── */
    .feature-visual {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .mockup {
        width: 100%;
        max-width: 480px;
        border-radius: var(--radius-card);
        background: var(--bg-card);
        border: 1.5px solid var(--border);
        box-shadow: var(--shadow-card);
        overflow: hidden;
    }

    /* ─── Network mockup ─────────────────────────────────────────── */
    .mockup--network {
        padding: 24px;
        min-height: 240px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
    }
    .network-svg { width: 100%; height: auto; max-height: 240px; }

    /* ─── Window-style mockup shared ────────────────────────────── */
    .mockup-window { border-radius: var(--radius-card); overflow: hidden; }

    .mockup-window__bar {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 10px 14px;
        background: #f1f5f9;
        border-bottom: 1px solid var(--border);
    }
    .mockup-window__bar--dark { background: #1e293b; border-color: #334155; }

    .mockup-window__dot {
        width: 9px; height: 9px;
        border-radius: 50%;
        background: #cbd5e1;
        flex-shrink: 0;
    }
    .mockup-window__dot:nth-child(1) { background: #f87171; }
    .mockup-window__dot:nth-child(2) { background: #fbbf24; }
    .mockup-window__dot:nth-child(3) { background: #4ade80; }

    .mockup-window__title {
        margin-left: 8px;
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--ink-muted);
        letter-spacing: 0.01em;
    }

    .mockup-window__body { padding: 14px 16px 16px; }

    /* ─── Scheduler mockup internals ────────────────────────────── */
    .mock-field { margin-bottom: 10px; }
    .mock-field__label {
        font-size: 0.65rem;
        font-weight: 600;
        color: var(--ink-muted);
        margin-bottom: 4px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
    }
    .mock-field__input {
        height: 22px;
        background: var(--border);
        border-radius: 4px;
    }
    .mock-field__input--short { width: 60%; }

    .mock-account-list { display: flex; flex-direction: column; gap: 5px; }
    .mock-account {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.65rem;
        color: var(--ink-muted);
    }
    .mock-account__avatar {
        width: 18px; height: 18px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--green-muted), var(--green));
        flex-shrink: 0;
    }
    .mock-account__name { flex: 1; font-size: 0.65rem; color: var(--ink); font-weight: 500; }
    .mock-account__user {
        width: 50px; height: 8px;
        background: var(--border);
        border-radius: 3px;
    }

    .mock-calendar-popup {
        background: white;
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 8px;
        margin: 8px 0;
        box-shadow: 0 4px 12px rgba(0,0,0,.08);
        width: fit-content;
    }
    .mock-cal-tabs { display: flex; gap: 4px; margin-bottom: 6px; }
    .mock-cal-tab {
        padding: 2px 8px;
        border-radius: 4px;
        font-size: 0.6rem;
        font-weight: 600;
        background: #f1f5f9;
        color: var(--ink-muted);
    }
    .mock-cal-tab--active { background: var(--green); color: white; }
    .mock-cal-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2px;
    }
    .mock-cal-cell {
        padding: 3px 6px;
        font-size: 0.6rem;
        text-align: center;
        color: var(--ink-muted);
        border-radius: 3px;
        background: #f8fafc;
    }

    .mock-schedule-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
    }
    .mock-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
    .mock-dot--green { background: var(--green); }
    .mock-bar { height: 8px; border-radius: 3px; background: var(--border); }
    .mock-bar--date { width: 80px; }

    /* ─── Content mgmt mockup internals ─────────────────────────── */
    .mockup-window--dark { background: #0f172a; }
    .mockup-window--dark .mockup-window__body { background: #0f172a; }

    .mock-posts-header {
        font-size: 0.6rem;
        color: #64748b;
        padding-bottom: 6px;
        border-bottom: 1px solid #1e293b;
        margin-bottom: 8px;
    }
    .mock-posts-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4px;
    }
    .mock-post-item {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 5px 7px;
        border-radius: 6px;
        background: #1e293b;
    }
    .mock-post-item--highlight { background: #166534; }
    .mock-post-avatar {
        width: 16px; height: 16px;
        border-radius: 50%;
        background: #334155;
        flex-shrink: 0;
    }
    .mock-post-name { font-size: 0.58rem; color: #94a3b8; font-weight: 500; }
    .mock-delete-btn {
        margin-top: 10px;
        width: fit-content;
        background: #ef4444;
        color: white;
        font-size: 0.6rem;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 4px;
    }

    /* ─── Studio mockup internals ────────────────────────────────── */
    .mock-studio-tag { display: flex; gap: 6px; margin-bottom: 10px; }
    .mock-tag {
        font-size: 0.6rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 999px;
    }
    .mock-tag--green { background: var(--green-muted); color: var(--green-dim); }
    .mock-tag--gray  { background: #f1f5f9; color: var(--ink-muted); }

    .mock-studio-hero {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 10px;
        background: white;
        border: 1px solid var(--border);
        border-radius: 8px;
        margin-bottom: 10px;
    }
    .mock-studio-icon {
        width: 32px; height: 32px;
        border-radius: 6px;
        background: var(--green-muted);
        color: var(--green);
        font-size: 12px;
        display: flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .mock-studio-copy { flex: 1; }
    .mock-studio-title { font-size: 0.65rem; font-weight: 700; color: var(--ink); margin-bottom: 4px; }
    .mock-studio-desc {
        height: 6px;
        background: var(--border);
        border-radius: 3px;
        margin-bottom: 3px;
        width: 90%;
    }
    .mock-studio-desc--short { width: 60%; }
    .mock-btn-pill {
        font-size: 0.58rem;
        font-weight: 600;
        background: var(--green);
        color: white;
        padding: 4px 8px;
        border-radius: 999px;
        white-space: nowrap;
        align-self: center;
    }

    .mock-template-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 6px;
    }
    .mock-template-card {
        background: white;
