---
export interface Props {
    id: string;
    title?: string;
}

const countryCode = Astro.locals.countryCode || "US"
import { ContactUsForm } from './ContactUsForm.tsx';
const { id, title = "Contact Us" } = Astro.props;
---

<dialog
        id={id}
        class="modal-dialog m-auto w-[calc(100%-2rem)] max-w-3xl rounded-2xl bg-background p-0 shadow-card backdrop:bg-ink/50 backdrop:backdrop-blur-md"
>
    <div class="relative">
        <!-- Close -->
        <button
                type="button"
                class="modal-close cursor-pointer absolute right-3 top-3 z-10 inline-flex h-8 w-8 items-center justify-center rounded-full text-muted transition-colors hover:bg-brand-soft hover:text-brand"
                aria-label="Close dialog"
        >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>

        <!-- Main content -->
        <div class="modal-content grid grid-cols-1 md:grid-cols-[1fr_2fr]">
            <!-- Left: Instructions -->
            <div class="instructions flex flex-col justify-center bg-brand-soft/40 p-6 md:p-8">
                <h3 class="font-display text-xl font-bold text-ink">{title}</h3>
                <p class="mt-3 text-sm leading-relaxed text-muted">
                    We'd like to get in touch with you. Kindly fill this form and we'll get back to you asap!
                </p>
            </div>

            <!-- Right: Form -->
            <ContactUsForm id={id} country={countryCode} client:load />
        </div>
    </div>
</dialog>

<style>
    body:has(dialog[open]) {
        overflow: hidden;
    }

    .modal-dialog {
        opacity: 0;
        transform: scale(0.96);
        transition: opacity 0.2s ease, transform 0.2s ease, overlay 0.2s ease allow-discrete;
    }

    .modal-dialog[open] {
        opacity: 1;
        transform: scale(1);
    }

    @starting-style {
        .modal-dialog[open] {
            opacity: 0;
            transform: scale(0.96);
        }
    }

    .modal-dialog::backdrop {
        opacity: 0;
        transition: opacity 0.2s ease;
    }

    .modal-dialog[open]::backdrop {
        opacity: 1;
    }

    .modal-content:has([data-success="true"]) {
        grid-template-cols: 1fr;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 400px;
    }

    .modal-content:has([data-success="true"]) .instructions {
        display: none;
    }

    @starting-style {
        .modal-dialog[open]::backdrop {
            opacity: 0;
        }
    }
</style>

<script>
    document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const dialog = target.closest('dialog.modal-dialog');
        if (dialog && target === dialog) {
            (dialog as HTMLDialogElement).close();
        }
    });

    document.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.modal-close');
        if (!btn) return;
        const dialog = btn.closest('dialog');
        if (dialog) (dialog as HTMLDialogElement).close();
    });
</script>