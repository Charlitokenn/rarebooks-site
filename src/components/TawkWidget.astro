---
import { env } from "cloudflare:workers";
const userDetails = await Astro.locals.currentUser();
const firstName = userDetails?.firstName;
const email = userDetails?.emailAddresses?.[0]?.emailAddress ?? "";
const userId = userDetails?.id ?? "";

async function hmacSha256(email: string, secret: string): Promise<string> {
    const key = await crypto.subtle.importKey("raw", new TextEncoder().encode(secret), { name: "HMAC", hash: "SHA-256" }, false, ["sign"]);
    const sig = await crypto.subtle.sign("HMAC", key, new TextEncoder().encode(email));
    return Array.from(new Uint8Array(sig)).map(b => b.toString(16).padStart(2, "0")).join("");
}

const tawkKey = env.TAWK_API_KEY;
const hash = userId ? await hmacSha256(userId, tawkKey) : "";
---

<!--
  This div is the ONLY thing Astro's ClientRouter is told to keep alive
  across navigations. Tawk's embed script normally appends its own
  container/iframe to <body>, which would get wiped on every swap — the
  inline script below redirects Tawk's insertion calls so its nodes are
  created directly inside this div instead (see the comment in that script
  for why we don't just relocate them afterwards).
-->
<div id="tawk-persist-root" transition:persist="tawk-widget" style="display:contents"></div>

<script is:inline define:vars={{ firstName, email, hash, userId }}>
    (function () {
        var root = document.getElementById("tawk-persist-root");

        function isTawkNode(node) {
            if (!node || node.nodeType !== 1) return false;
            var id = node.id || "";
            var title = (node.getAttribute && node.getAttribute("title")) || "";
            return id.indexOf("tawk") === 0 || (node.tagName === "IFRAME" && /chat/i.test(title));
        }

        // IMPORTANT: we used to let Tawk's embed script append its
        // container/iframe to <body> as normal, then move those nodes into
        // `root` ourselves afterwards. That was the actual cause of the
        // widget failing to render: moving an already-inserted <iframe>
        // anywhere in the DOM (even via appendChild to a new parent) forces
        // the browser to fully reload its contentWindow — this is
        // universal browser behavior, not a bug in one engine. That reload
        // was firing the instant Tawk's own onLoad handler completed,
        // interrupting its boot sequence at the worst possible moment: the
        // embed script would report as loaded (visible in the Network
        // tab), but the widget itself never finished rendering.
        //
        // The fix is to never move the live node at all. We redirect
        // Tawk's own body.appendChild/insertBefore calls so its container
        // is created directly inside `root` in the first place — the node
        // is never reparented after insertion, so there's nothing to
        // reload.
        if (root && !document.body.appendChild.__tawkPatched) {
            var originalAppendChild = document.body.appendChild.bind(document.body);
            var originalInsertBefore = document.body.insertBefore.bind(document.body);

            var patchedAppendChild = function (node) {
                if (isTawkNode(node)) return root.appendChild(node);
                return originalAppendChild(node);
            };
            patchedAppendChild.__tawkPatched = true;
            document.body.appendChild = patchedAppendChild;

            document.body.insertBefore = function (node, ref) {
                if (isTawkNode(node)) return root.appendChild(node);
                return originalInsertBefore(node, ref);
            };
        }

        window.Tawk_API = window.Tawk_API || {};
        window.Tawk_API.visitor = { name: firstName || "", email: email || "", hash: hash || "" };

        // window (and window.Tawk_API) survives Astro client-side navigation —
        // only the DOM gets swapped. So only ever load the embed script ONCE.
        if (window.__tawkInitialized) {
            if (userId && hash && window.Tawk_API.login) {
                window.Tawk_API.login(
                    { hash: hash, userId: userId, name: firstName || "", email: email || "" },
                    function (error) { if (error) console.error("Tawk.to login error:", error); }
                );
            }
            return;
        }
        window.__tawkInitialized = true;

        window.Tawk_API.onLoad = function () {
            if (userId && hash) {
                window.Tawk_API.login(
                    { hash: hash, userId: userId, name: firstName || "", email: email || "" },
                    function (error) { if (error) console.error("Tawk.to login error:", error); }
                );
            }
        };

        // Required by Tawk's embed script — official snippet always sets this.
        window.Tawk_LoadStart = new Date();

        var s1 = document.createElement("script"),
            s0 = document.getElementsByTagName("script")[0];
        s1.async = true;
        s1.src = "https://embed.tawk.to/6a43b438854f801d4378af24/1jsc7fva2";
        s1.charset = "UTF-8";
        s1.setAttribute("crossorigin", "*");
        s0.parentNode.insertBefore(s1, s0);
    })();
</script>