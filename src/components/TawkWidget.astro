---
import { env } from "cloudflare:workers";
const userDetails = await Astro.locals.currentUser();
const fullName = userDetails?.fullName;
const email = userDetails?.emailAddresses?.[0]?.emailAddress ?? "";
const userId = userDetails?.id ?? "";

async function hmacSha256(message: string, secret: string): Promise<string> {
    const key = await crypto.subtle.importKey("raw", new TextEncoder().encode(secret), { name: "HMAC", hash: "SHA-256" }, false, ["sign"]);
    const sig = await crypto.subtle.sign("HMAC", key, new TextEncoder().encode(message));
    return Array.from(new Uint8Array(sig)).map(b => b.toString(16).padStart(2, "0")).join("");
}

const tawkKey = env.TAWK_API_KEY;

// Tawk uses TWO different hash formulas for two different features, and
// this component was computing one hash and reusing it for both — which
// is wrong for at least one of them no matter which message you pick:
//
//   - `Tawk_API.visitor.hash`   = HMAC-SHA256(email,  API-key)
//   - `Tawk_API.login()`'s hash = HMAC-SHA256(userId, API-key)
//
// (https://developer.tawk.to/jsapi — "Secure Mode" and "login")
//
// Previously this hashed `userId` and used that single value for both
// spots — correct for login(), but an invalid `visitor.hash` on every
// signed-in visitor. And for anonymous visitors (no email/userId) it was
// still sending `visitor: { hash: "" }` on every single page load — an
// empty hash on a Secure Mode property looks identical to a forged one,
// which is very likely why the widget wasn't rendering for anyone at all,
// not just signed-in users.
let visitorHash = "";
let loginHash = "";

if (tawkKey) {
    if (email) visitorHash = await hmacSha256(email, tawkKey);
    if (userId) loginHash = await hmacSha256(userId, tawkKey);
} else if (userId) {
    console.warn("[TawkWidget] TAWK_API_KEY is not set — skipping Secure Mode hashes.");
}

// Only attempt visitor identification / login when we actually have a
// verified pair. Anonymous visitors get no `visitor` object at all, so
// Tawk treats them as ordinary anonymous chat guests instead of a failed
// secure-mode identification attempt.
const hasIdentifiedVisitor = Boolean(email && visitorHash);
const canLogin = Boolean(userId && loginHash);
---

<!--
  This div is the ONLY thing Astro's ClientRouter is told to keep alive
  across navigations. Tawk's embed script manages its own nodes as normal
  children of <body> during regular use — the inline script below only
  moves them in here at the one moment it's needed: right before an actual
  navigation swap (see the astro:before-swap listener in that script for
  why we don't touch Tawk's DOM at any other time).
-->
<div id="tawk-persist-root" transition:persist="tawk-widget" style="display:contents"></div>

<script is:inline define:vars={{ fullName, email, visitorHash, loginHash, userId, hasIdentifiedVisitor, canLogin }}>
    (function () {
        var root = document.getElementById("tawk-persist-root");

        // We previously redirected Tawk's own body.appendChild/insertBefore
        // calls so its nodes would be created inside `root` directly. That
        // backfired: Tawk's own script still assumes — and internally
        // tracks — that its nodes are direct children of <body>. Once we
        // silently moved them into `root` behind its back, any later DOM
        // operation Tawk performs that depends on that assumption (closing
        // the chat window, repositioning on click, periodic housekeeping)
        // could end up targeting the wrong parent and silently fail —
        // which is exactly what was causing the widget to vanish a few
        // seconds in, or the moment it was clicked.
        //
        // So Tawk's DOM is now left completely alone during normal
        // operation. The only time we touch it is right before an actual
        // Astro navigation swap, via astro:before-swap — at that one
        // moment we move any live Tawk nodes into the persisted `root` so
        // they survive the swap instead of being wiped with the rest of
        // the old page. That does cause a brief iframe reload (browsers
        // always reload a live <iframe> when it's moved anywhere in the
        // DOM — universal, spec'd behavior, not a bug), but confining it
        // to actual page-transition moments — instead of doing it
        // continuously during normal use — means it never interrupts
        // someone who's actively got the chat open.
        function relocateTawkNodes() {
            if (!root) return;
            document.querySelectorAll('[id^="tawk"], iframe[title*="chat" i], iframe[title*="tawk" i]').forEach(function (node) {
                if (node.parentElement !== root) root.appendChild(node);
            });
        }

        function restoreTawkNodes(){
            if(!root) return;
            document.querySelectorAll('[id^="tawk"], iframe[title*="chat" i], iframe[title*="tawk" i]').forEach(function (node) {
                //Only move nodes that are currently inside the persist root
                if(node.parentElement === root){
                    document.body.appendChild(node);
                }
            });
        }

        if (!window.__tawkBeforeSwapListenerAdded) {
            document.addEventListener("astro:before-swap", relocateTawkNodes);
            window.__tawkBeforeSwapListenerAdded = true;
        }

        //Restore tawk nodes to <body> after swap
        if(!window.__tawkBeforeSwapListenerAdded){
            document.addEventListener("astro:after-swap", restoreTawkNodes);
            window.__tawkAfterSwapListernerAdded = true;
        }

        // Astro's <ClientRouter /> works by globally watching clicks on <a>
        // elements anywhere on the page and intercepting them to do a
        // client-side navigation instead of a normal browser navigation
        // (https://docs.astro.build — "Router control"). Tawk's own bubble
        // trigger is a real element in this page's DOM (only the expanded
        // chat window itself is an iframe), and if any part of Tawk's
        // markup involves an anchor tag, Astro's router can catch that
        // click and treat it as an in-app route change — remounting
        // everything on the page that isn't transition:persist'ed
        // (including the license dashboard, which is why its data refetch
        // was firing at the exact moment the widget closed), and wiping
        // Tawk's own DOM along with it since that "navigation" also
        // triggers the astro:before-swap relocation above, mid-interaction.
        //
        // We stop that at the source: any click that originates from
        // inside Tawk's widget is stopped from propagating up to Astro's
        // listener at all, in the capture phase — so it never gets a
        // chance to misinterpret it as in-app navigation, regardless of
        // where in the DOM Tawk's nodes currently live.
        if (!window.__tawkClickGuardAdded) {
            document.addEventListener(
                "click",
                function (event) {
                    var target = event.target;
                    if (target && target.closest && target.closest('[id^="tawk"], iframe[title*="chat" i], iframe[title*="tawk" i]')) {
                        event.stopPropagation();
                    }
                },
                true // capture phase — runs before Astro's own (bubble-phase) listener, regardless of registration order
            );
            window.__tawkClickGuardAdded = true;
        }

        window.Tawk_API = window.Tawk_API || {};
        // Anonymous visitors get no `visitor` object at all — see the note
        // in the frontmatter above for why sending one with an empty/wrong
        // hash was likely blocking the widget outright on a Secure Mode
        // property.
        if (hasIdentifiedVisitor) {
            window.Tawk_API.visitor = { name: fullName || "", email: email, hash: visitorHash };
        }

        // window (and window.Tawk_API) survives Astro client-side navigation —
        // only the DOM gets swapped. So only ever load the embed script ONCE.
        if (window.__tawkInitialized) {
            if (canLogin && window.Tawk_API.login) {
                window.Tawk_API.login(
                    { hash: loginHash, userId: userId, name: fullName || "", email: email || "" },
                    function (error) { if (error) console.error("Tawk.to login error:", error); }
                );
            }
            return;
        }
        window.__tawkInitialized = true;

        window.Tawk_API.onLoad = function () {
            if (canLogin) {
                window.Tawk_API.login(
                    { hash: loginHash, userId: userId, name: fullName || "", email: email || "" },
                    function (error) { if (error) console.error("Tawk.to login error:", error); }
                );
            }
        };

        // Required by Tawk's embed script — official snippet always sets this.
        window.Tawk_LoadStart = new Date();

        var s1 = document.createElement("script"),
            s0 = document.getElementsByTagName("script")[0];
        s1.async = true;
        s1.src = "https://embed.tawk.to/6a43b438854f801d4378af24/1jsc7fva2";
        s1.charset = "UTF-8";
        s1.setAttribute("crossorigin", "*");
        s0.parentNode.insertBefore(s1, s0);
    })();
</script>