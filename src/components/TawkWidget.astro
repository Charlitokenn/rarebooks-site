---
import { env } from "cloudflare:workers";

const userDetails = await Astro.locals.currentUser?.();
const email = userDetails?.emailAddresses?.[0]?.emailAddress ?? "";
const userId = userDetails?.id ?? "";

async function hmacSha256(message: string, secret: string): Promise<string> {
  const key = await crypto.subtle.importKey(
    "raw",
    new TextEncoder().encode(secret),
    { name: "HMAC", hash: "SHA-256" },
    false,
    ["sign"]
  );
  const sig = await crypto.subtle.sign("HMAC", key, new TextEncoder().encode(message));
  return Array.from(new Uint8Array(sig))
    .map(b => b.toString(16).padStart(2, "0"))
    .join("");
}

const tawkKey = env.TAWK_API_KEY;

let visitorHash = "";
let loginHash = "";

if (tawkKey) {
  if (email) visitorHash = await hmacSha256(email, tawkKey);
  if (userId) loginHash = await hmacSha256(userId, tawkKey);
} else {
  console.warn("[TawkWidget] TAWK_API_KEY is not set — Secure Mode disabled.");
}

const hasIdentifiedVisitor = Boolean(email && visitorHash);
const canLogin = Boolean(userId && loginHash);
---

<!-- Start of Tawk.to Script -->
<script is:inline define:vars={{ hasIdentifiedVisitor, email, visitorHash, canLogin, userId, loginHash }}>
  var Tawk_API = Tawk_API || {};
  var Tawk_LoadStart = new Date();

  // Only attach visitor object when we have VALID credentials
  if (hasIdentifiedVisitor) {
    Tawk_API.visitor = {
      name: email,
      email: email,
      hash: visitorHash
    };
  }

  // Only call login() when we have a valid userId hash
  if (canLogin) {
    Tawk_API.onLoad = function() {
      Tawk_API.login({
        name: email,
        email: email,
        userId: userId,
        hash: loginHash
      }, function(error) {
        if (error) console.error("[Tawk.to] Login failed:", error);
      });
    };
  }

  (function() {
    var s1 = document.createElement("script"),
        s0 = document.getElementsByTagName("script")[0];
    s1.async = true;
    s1.src = 'https://embed.tawk.to/YOUR_PROPERTY_ID/YOUR_WIDGET_ID';
    s1.charset = 'UTF-8';
    s1.setAttribute('crossorigin', '*');
    s0.parentNode.insertBefore(s1, s0);
  })();
</script>
<!-- End of Tawk.to Script -->
