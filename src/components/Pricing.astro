---
import { Check } from "lucide-astro"

const plans = [
  {
    name: "Starter",
    price: "$29",
    period: "/mo",
    blurb: "For freelancers and side projects finding their footing.",
    features: ["Up to 100 transactions/mo", "Auto-categorization", "Live P&L dashboard", "Email support"],
    featured: false,
  },
  {
    name: "Growth",
    price: "$79",
    period: "/mo",
    blurb: "For growth-stage startups that need clean, investor-ready books.",
    features: [
      "Unlimited transactions",
      "Real-time reconciliation",
      "Tax-ready reports & exports",
      "Accountant collaboration",
      "Priority support",
    ],
    featured: true,
  },
  {
    name: "Scale",
    price: "Custom",
    period: "",
    blurb: "For larger teams with multiple entities and currencies.",
    features: ["Multi-entity consolidation", "Multi-currency", "Dedicated success manager", "API access"],
    featured: false,
  },
]
---

<section id="pricing" class="mx-auto max-w-6xl px-4 py-24">
  <div class="mx-auto mb-14 max-w-2xl text-center">
    <h2 class="text-balance font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
      Simple, transparent pricing.
    </h2>
    <p class="mt-4 text-lg text-muted">No hourly billing. No surprises. Cancel anytime.</p>
  </div>

  <div class="grid gap-6 lg:grid-cols-3">
    {
      plans.map((plan) => (
        <div
          class={`flex flex-col rounded-3xl p-8 ${
            plan.featured
              ? "border-2 border-brand bg-ink text-white shadow-soft"
              : "border border-black/5 bg-white text-ink shadow-card"
          }`}
        >
          {plan.featured && (
            <span class="mb-4 inline-flex w-fit rounded-pill bg-brand px-3 py-1 text-xs font-semibold text-white">
              Most popular
            </span>
          )}
          <h3 class="font-display text-xl font-bold">{plan.name}</h3>
          <div class="mt-4 flex items-end gap-1">
            <span class="font-display text-5xl font-extrabold tracking-tight">{plan.price}</span>
            <span class={plan.featured ? "mb-1.5 text-white/60" : "mb-1.5 text-muted"}>
              {plan.period}
            </span>
          </div>
          <p class={`mt-3 text-sm leading-relaxed ${plan.featured ? "text-white/70" : "text-muted"}`}>
            {plan.blurb}
          </p>
          <ul class="mt-6 flex flex-1 flex-col gap-3">
            {plan.features.map((f) => (
              <li class="flex items-center gap-2.5 text-sm">
                <span
                  class={`flex h-5 w-5 shrink-0 items-center justify-center rounded-full ${
                    plan.featured ? "bg-brand text-white" : "bg-brand-soft text-brand"
                  }`}
                >
                  <Check size={12} />
                </span>
                <span class={plan.featured ? "text-white/90" : "text-ink"}>{f}</span>
              </li>
            ))}
          </ul>
          <a
            href="#cta"
            class={`mt-8 inline-flex items-center justify-center rounded-pill px-6 py-3 text-sm font-semibold transition-transform hover:-translate-y-0.5 ${
              plan.featured
                ? "bg-white text-ink"
                : "bg-ink text-white"
            }`}
          >
            {plan.price === "Custom" ? "Contact sales" : "Start free trial"}
          </a>
        </div>
      ))
    }
  </div>
</section>
