---
export const prerender = false;

import { Check } from "@lucide/astro";
import { AppConfig } from "../constants";
import { isTanzania } from "../constants/pricing.ts";

const countryCode = Astro.locals.countryCode || "US";
const isLocal = isTanzania(countryCode);
const plan = AppConfig.hostedPlan;
const [digitization, quickStart] = AppConfig.localServices;

// Abroad, the yearly plan is shown first and carries the pay now bonus.
const usdPlans = [
  {
    name: `${plan.name} Yearly`,
    price: `$${plan.priceUSD.yearly}`,
    period: "/Year",
    note: `Save $${plan.priceUSD.yearlySaving} on monthly billing`,
    extras: ["Free data import when you take the year during your trial"],
    featured: true,
  },
  {
    name: `${plan.name} Monthly`,
    price: `$${plan.priceUSD.monthly}`,
    period: "/Month",
    note: "Billed monthly after your free trial",
    extras: [],
    featured: false,
  },
];

function cardClass(featured: boolean): string {
  return featured
    ? "flex flex-col rounded-3xl border-2 border-brand bg-ink/85 p-8 text-white shadow-soft"
    : "flex flex-col rounded-3xl border border-black/5 bg-white p-8 text-ink shadow-card";
}

function ctaClass(featured: boolean): string {
  return `mt-8 inline-flex cursor-pointer items-center justify-center rounded-pill px-6 py-3 text-sm font-semibold transition-transform hover:-translate-y-0.5 ${
    featured ? "bg-white text-ink" : "bg-brand text-white"
  }`;
}
---

<section id="pricing" class="mx-auto max-w-6xl px-4 py-24">
  <div class="mx-auto mb-14 max-w-2xl text-center">
    <h2 class="text-balance font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
      One plan. Everything included.
    </h2>
    <p class="mt-4 text-lg text-muted">
      {isLocal
        ? "Start free. If you want us to do the setup for you, add a quick start or have your notebooks digitized."
        : "Start free. Pay yearly and save, or go month to month."}
    </p>
  </div>

  {isLocal ? (
    <div class="grid gap-6 lg:grid-cols-3">
      {[digitization, null, quickStart].map((service) =>
        service ? (
          <div class={cardClass(false)}>
            <h3 class="font-display text-xl font-bold">{service.name}</h3>
            <p class="mt-4 font-display text-3xl font-extrabold tracking-tight">{service.price}</p>
            <p class="mt-1 text-sm font-medium text-brand">{service.priceNote}</p>
            <p class="mt-3 text-sm leading-relaxed text-muted">{service.blurb}</p>
            <ul class="mt-6 flex flex-1 flex-col gap-3">
              {service.features.map((feature) => (
                <li class="flex items-start gap-2.5 text-sm">
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-soft text-brand">
                    <Check size={12} />
                  </span>
                  <span class="text-ink">{feature}</span>
                </li>
              ))}
            </ul>
            <button
              type="button"
              data-open-modal="contact-us-modal"
              data-cta-location="pricing_page"
              data-plan-name={service.name}
              class={ctaClass(false)}
            >
              {service.cta}
            </button>
          </div>
        ) : (
          <div class={cardClass(true)}>
            <span class="mb-4 inline-flex w-fit rounded-pill bg-brand px-3 py-1 text-xs font-semibold text-white">
              The plan
            </span>
            <h3 class="font-display text-xl font-bold">{plan.name}</h3>
            <div class="mt-4 flex items-end gap-1">
              <span class="font-display text-4xl font-extrabold tracking-tight">TZS {plan.priceTZS.yearly}</span>
              <span class="mb-1.5 text-white/60">/Year</span>
            </div>
            <p class="mt-3 text-sm leading-relaxed text-white/70">
              Everything RareBooks does, for your whole shop. Pay once a year by mobile money.
            </p>
            <ul class="mt-6 flex flex-1 flex-col gap-3">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-2.5 text-sm">
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand text-white">
                    <Check size={12} />
                  </span>
                  <span class="text-white/90">{feature}</span>
                </li>
              ))}
            </ul>
            <a
              href={AppConfig.urls.signUpUrl}
              data-cta-location="pricing_page"
              data-plan-name={plan.name}
              class={ctaClass(true)}
            >
              Start free trial
            </a>
          </div>
        ),
      )}
    </div>
  ) : (
    <>
      <div class="mx-auto grid max-w-4xl gap-6 md:grid-cols-2">
        {usdPlans.map((usdPlan) => (
          <div class={cardClass(usdPlan.featured)}>
            {usdPlan.featured && (
              <span class="mb-4 inline-flex w-fit rounded-pill bg-brand px-3 py-1 text-xs font-semibold text-white">
                Best value
              </span>
            )}
            <h3 class="font-display text-xl font-bold">{usdPlan.name}</h3>
            <div class="mt-4 flex items-end gap-1">
              <span class="font-display text-5xl font-extrabold tracking-tight">{usdPlan.price}</span>
              <span class={usdPlan.featured ? "mb-1.5 text-white/60" : "mb-1.5 text-muted"}>{usdPlan.period}</span>
            </div>
            <p class={`mt-3 text-sm leading-relaxed ${usdPlan.featured ? "text-white/70" : "text-muted"}`}>
              {usdPlan.note}
            </p>
            <ul class="mt-6 flex flex-1 flex-col gap-3">
              {[...usdPlan.extras, ...plan.features].map((feature) => (
                <li class="flex items-start gap-2.5 text-sm">
                  <span
                    class={`mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full ${
                      usdPlan.featured ? "bg-brand text-white" : "bg-brand-soft text-brand"
                    }`}
                  >
                    <Check size={12} />
                  </span>
                  <span class={usdPlan.featured ? "text-white/90" : "text-ink"}>{feature}</span>
                </li>
              ))}
            </ul>
            <a
              href={AppConfig.urls.signUpUrl}
              data-cta-location="pricing_page"
              data-plan-name={usdPlan.name}
              class={ctaClass(usdPlan.featured)}
            >
              Start free trial
            </a>
          </div>
        ))}
      </div>
      <p class="mx-auto mt-8 max-w-2xl text-center text-sm text-muted">
        Switching from QuickBooks, Sage or Tally? Take the yearly plan during your trial and we import
        your data for you.
        <button type="button" data-open-modal="contact-us-modal" class="cursor-pointer font-semibold text-brand underline">
          Ask us how
        </button>
      </p>
    </>
  )}
</section>
