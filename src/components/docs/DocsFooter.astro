---
// The docs footer (spec 0024 AC-4): a Starlight `Footer` override. It renders Starlight's own edit link, last
// updated date and pagination (through the virtual modules, so the Pagination override is used). No marketing
// strip and no Starlight credits.
import EditLink from "virtual:starlight/components/EditLink";
import LastUpdated from "virtual:starlight/components/LastUpdated";
import Pagination from "virtual:starlight/components/Pagination";
---

<footer class="docs-footer">
  <div class="docs-meta">
    <EditLink />
    <LastUpdated />
  </div>
  <Pagination />
</footer>

<style>
  .docs-footer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .docs-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 3rem;
    margin-top: 3rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }

  .docs-meta > :global(p:only-child) {
    margin-inline-start: auto;
  }
</style>
