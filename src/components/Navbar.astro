---
import { BookOpen } from "lucide-astro"

const links = [
  { label: "Features", href: "#features" },
  { label: "How it works", href: "#how" },
  { label: "Ledgerly in Action", href: "#guarantee" },
  { label: "Pricing", href: "#pricing" },
]
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 rounded-pill border border-black/5 bg-white/80 px-4 py-2.5 shadow-card backdrop-blur-md"
  >
    <a href="#top" class="flex items-center gap-2.5 pl-1">
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-ink text-white">
        <BookOpen size={18} />
      </span>
      <span class="text-lg font-bold tracking-tight text-ink font-display">Ledgerly</span>
    </a>

    <div class="hidden items-center gap-8 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-muted transition-colors hover:text-ink"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <a
        href="#cta"
        class="inline-flex items-center rounded-pill bg-ink px-5 py-2.5 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5"
      >
        Get Started
      </a>
    </div>
  </nav>
</header>
