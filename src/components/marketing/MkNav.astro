---
// The marketing header (spec 0018): skip link, sticky bar, four flat links, and the signed in or signed out
// buttons, decided on the server so the first HTML byte is already right (AC-4). Below `md` the links and
// buttons move into a native <dialog> sheet, opened by the Layout `data-open-modal` handler (AC-5).
import { AppConfig } from "../../constants/index.ts";
import { dashboardPath, navLinks, signInPath } from "../../constants/navigation.ts";
import { compareCurrent, isSignedIn } from "../../lib/marketing/navigation.ts";
import MkButton from "./MkButton.astro";
import MkLogo from "./MkLogo.astro";

const signedIn = isSignedIn(Astro.locals);
const current = compareCurrent(Astro.url.pathname);
// AC-7: only Compare is ever marked.
const ariaCurrent = (href: string) => (href === "/compare" ? current : undefined);

const motion = "motion-safe:transition-colors motion-safe:duration-150 motion-safe:ease-mk";
const linkClass = [
  "inline-flex min-h-11 items-center rounded-mk-sm font-mk-sans text-mk-body font-semibold text-mk-ink",
  "no-underline decoration-mk-brand decoration-2 underline-offset-8 hover:text-mk-brand",
  "[&[aria-current]]:underline",
  motion,
];
---

<a
  href="#main"
  class="sr-only z-50 rounded-mk-pill bg-mk-surface px-5 py-3 font-mk-sans text-mk-body font-bold text-mk-ink shadow-mk-card focus:not-sr-only focus:fixed focus:top-2 focus:left-4 focus:px-5 focus:py-3 focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-mk-focus"
>
  Skip to content
</a>

<header class="mk-band sticky top-0 z-40 h-16 border-b border-mk-border px-5 md:px-8" data-tone="canvas">
  <div class="mx-auto flex h-full w-full max-w-mk items-center gap-8">
    <MkLogo />

    <nav aria-label="Main" class="hidden md:block" data-mk-nav-desktop>
      <ul class="flex items-center gap-6" role="list">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class:list={linkClass} aria-current={ariaCurrent(link.href)}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="ml-auto hidden items-center gap-5 md:flex">
      {
        signedIn ? (
          <MkButton href={dashboardPath}>Dashboard</MkButton>
        ) : (
          <>
            <a href={signInPath} class:list={linkClass}>
              Sign in
            </a>
            <MkButton href={AppConfig.urls.signUpUrl} data-cta-location="nav">
              Start free trial
            </MkButton>
          </>
        )
      }
    </div>

    <button
      type="button"
      class:list={[
        "ml-auto inline-flex min-h-11 items-center gap-2 rounded-mk-pill border-2 border-mk-ink px-4",
        "font-mk-sans text-mk-body font-bold text-mk-ink hover:bg-mk-tint md:hidden",
        motion,
      ]}
      data-open-modal="mk-nav-menu"
      aria-haspopup="dialog"
      aria-controls="mk-nav-menu"
      aria-label="Open menu"
    >
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 5h14M3 10h14M3 15h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      Menu
    </button>
  </div>

  <dialog
    id="mk-nav-menu"
    aria-label="Menu"
    class="mk-nav-menu fixed inset-y-0 right-0 left-auto m-0 h-dvh max-h-none w-full max-w-80 p-0 backdrop:bg-mk-ink/50"
  >
    <div class="mk-band mk-on-light flex h-full flex-col gap-8 overflow-y-auto bg-mk-surface px-5 py-6">
      <nav aria-label="Main">
        <ul class="flex flex-col" role="list">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  class:list={[linkClass, "w-full text-mk-lead"]}
                  aria-current={ariaCurrent(link.href)}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-3">
        {
          signedIn ? (
            <MkButton href={dashboardPath} class="w-full">
              Dashboard
            </MkButton>
          ) : (
            <>
              <MkButton href={AppConfig.urls.signUpUrl} class="w-full" data-cta-location="nav-mobile">
                Start free trial
              </MkButton>
              <MkButton href={signInPath} variant="secondary" class="w-full">
                Sign in
              </MkButton>
            </>
          )
        }
      </div>

      <form method="dialog" class="mt-auto">
        <MkButton type="submit" variant="secondary" class="w-full" aria-label="Close menu">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          Close
        </MkButton>
      </form>
    </div>
  </dialog>
</header>

<style>
  /* AC-5 scroll lock: on body, as ContactUsModal does, never on html (that breaks the sticky header). */
  :global(body:has(#mk-nav-menu[open])) {
    overflow: hidden;
  }

  /* Slide in from the right, only for visitors who allow motion (AC-5). */
  @media (prefers-reduced-motion: no-preference) {
    .mk-nav-menu[open] {
      animation: mk-sheet-in 200ms var(--ease-mk);
    }

    .mk-nav-menu[open]::backdrop {
      animation: mk-fade-in 200ms var(--ease-mk);
    }
  }

  @keyframes mk-sheet-in {
    from {
      transform: translateX(100%);
    }
  }

  @keyframes mk-fade-in {
    from {
      opacity: 0;
    }
  }
</style>

<!--
  AC-5 close rules the browser doesn't give us: a tap on the backdrop (the only part that targets the dialog
  itself, since the inner wrapper fills the sheet), a tap on any link (the browser still follows it; no
  preventDefault, so the Layout trial handler still fires), and growing to md, where focus moves to the first
  desktop link because the Menu button is hidden there.
-->
<script is:inline>
  (function () {
    var d = document.getElementById("mk-nav-menu");
    if (!d) return;
    d.addEventListener("click", function (e) {
      if (e.target === d || e.target.closest("a")) d.close();
    });
    var m = matchMedia("(min-width: 48rem)");
    m.addEventListener("change", function (e) {
      if (!e.matches || !d.open) return;
      d.close();
      var f = document.querySelector("[data-mk-nav-desktop] a");
      if (f) f.focus();
    });
  })();
</script>
