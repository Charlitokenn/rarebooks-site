---
// The FAQ (spec 0019 AC-11): one MkFaq with the five questions in order. The last answer ends with a
// Contact us button, in the MkButton `link` look, that opens the contact modal through the Layout handler.
import { AppConfig } from "../../../constants";
import type { HomeCopy } from "../../../constants/home.ts";
import { fill, homeValues } from "../../../lib/marketing/home.ts";
import MkFaq from "../MkFaq.astro";
import MkHeading from "../MkHeading.astro";
import MkSection from "../MkSection.astro";

interface Props {
  copy: HomeCopy["faq"];
}

const { copy } = Astro.props;
const values = homeValues(AppConfig);

// The MkButton `link` variant's classes, on a real <button>: MkFaq answers are HTML strings, so the
// component itself can't go inside one. The copy is ours, never visitor input.
const contactButton =
  '<button type="button" data-open-modal="contact-us-modal" data-cta-location="faq" ' +
  'class="cursor-pointer rounded-sm font-bold text-(--mk-link) underline-offset-4 hover:underline focus-visible:underline">' +
  `${copy.contact}</button>`;

const items = copy.items.map((item, index) => {
  const answer = fill(item.answer, values);
  return {
    question: item.question,
    answer: index === copy.items.length - 1 ? `${answer} ${contactButton}` : answer,
  };
});
---

<MkSection tone="tint" id="faq" labelledby="home-faq-title" width="narrow">
  <MkHeading level={2} align="center" id="home-faq-title">{copy.title}</MkHeading>
  <MkFaq items={items} class="mt-10" />
</MkSection>
