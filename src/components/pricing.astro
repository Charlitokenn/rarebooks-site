---
import {AppConfig} from "../constants";
const leftFeatures = [
    {
        icon: "star",
        title: "A full 14-days trial:",
        description: "To run your real business operations in RareBooks i.e. track sales, stock and expenses.",
    },
    {
        icon: "users",
        title: "If not satisfied after trial:",
        description: "We export and give you all your data in a clean structured excel - ready to use anywhere! No questions asked.",
    },
    {
        icon: "star",
        title: "If it works for you:",
        description: "Purchase the annual license key and continue without any interruption.",
    },
];

const planFeatures = {
    name: "Yearly License",
    currency: "Tshs.",
    price: 490000,
    duration: "/year",
    subtitle: "per business, billed annually",
    trial: "Start my 14 days free trial",
    benefits: [
        "Real time stock balances",
        "Instant low stock notifications",
        "Double entry accounting system",
        "Profit and loss reports",
        "Software updates and improvements",
        "Training, support and software documentation",
        "Barcode scanning - sales & stock management",
        "Tax ready reports",
    ]
}
---

<section class="px-6 py-8 bg-white dark:bg-zinc-900">
    <div class="mx-auto grid max-w-5xl grid-cols-1 items-center gap-12 md:grid-cols-2">

        <div>
            <h2 class="mb-4 text-4xl font-extrabold leading-tight tracking-tight text-gray-900 dark:text-gray-100">
                Zero Risk - 14 Days Trial
            </h2>
            <p class="mb-2 max-w-md text-base leading-relaxed text-gray-600 dark:text-gray-400">
                Try out all features - <strong class="text-gray-900 dark:text-gray-100">no commitment</strong>. Get your entire business records digitized - For you.
                Your <strong class="text-gray-900 dark:text-gray-100">notebooks & excel sheets</strong> - stock, sales & expense records turned into a fully structured
                digital system inside RareBooks. After setup, you get;
            </p>

            <ul class="flex flex-col gap-4 mt-4">
                {leftFeatures.map((feat) => (
                        <li class="flex items-start gap-3">
                        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg bg-accent-100 dark:bg-accent-900/30 text-accent-600 dark:text-accent-400">
                          {feat.icon === "star" && (
                                  <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                                  </svg>
                          )}
                            {feat.icon === "users" && (
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                                        <circle cx="9" cy="7" r="4" />
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                                    </svg>
                            )}
                            {feat.icon === "chart" && (
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M21.21 15.89A10 10 0 1 1 8 2.83" />
                                        <path d="M22 12A10 10 0 0 0 12 2v10z" />
                                    </svg>
                            )}
                        </span>
                            <p class="pt-1 text-md leading-relaxed text-gray-600 dark:text-gray-400">
                                <strong class="font-bold text-gray-900 dark:text-gray-100">{feat.title}</strong>{" "}
                                {feat.description}
                            </p>
                        </li>
                ))}
            </ul>
        </div>

        <div class="overflow-hidden rounded-2xl border-3 border-gray-200 dark:border-gray-800 bg-accent-100 dark:bg-gray-900 shadow-xl dark:shadow-none">

            <div class="border-b border-gray-200 dark:border-gray-800 px-8 py-4">
                <p class="mb-2 text-2xl font-bold text-gray-900 dark:text-gray-100">{planFeatures.name}</p>
                <div class="mb-2 flex items-end gap-1 leading-none">
                    <span class="pb-2 text-xl font-semibold text-gray-900 dark:text-gray-100">{planFeatures.currency}</span>
                    <span class="text-7xl font-black tracking-tighter text-gray-900 dark:text-gray-100">{planFeatures.price.toLocaleString()}</span>
                    <span class="pb-2 text-base font-medium text-gray-500 dark:text-gray-400">{planFeatures.duration}</span>
                </div>
                <p class="text-sm text-gray-500 dark:text-gray-400">{planFeatures.subtitle}</p>
            </div>

            <div class="px-8 py-2">
                <p class="mb-2 text-xs font-bold uppercase tracking-widest text-accent-600 dark:text-accent-400">
                    What you get
                </p>

                <ul class="mb-5 grid grid-cols-2 gap-x-3 gap-y-3.5">
                    {planFeatures.benefits.map((benefit) => (
                            <li class="flex items-center gap-2 text-sm font-medium text-gray-700 dark:text-gray-300">
              <span class="shrink-0 text-accent-600 dark:text-accent-400">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                  <polyline points="22 4 12 14.01 9 11.01" />
                </svg>
              </span>
                                {benefit}
                            </li>
                    ))}
                </ul>

                <a
                        href={AppConfig.storeUrl}
                        class="block w-full rounded-xl py-2 mb-2 bg-accent-600 hover:bg-accent-700 dark:bg-accent-600 dark:hover:bg-accent-500 text-white text-center text-base font-semibold shadow-lg shadow-accent-500/25 dark:shadow-none transition-all duration-200 hover:-translate-y-0.5"
                >
                    {planFeatures.trial}
                </a>
            </div>

        </div>
    </div>
</section>