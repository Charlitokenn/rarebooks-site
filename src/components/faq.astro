---
const faqs = [
    {
        question: "Why switch from Buffer or Hootsuite?",
        answer:
            "We offer a more intuitive interface, better analytics, and a fairer pricing model — no hidden limits on post queues or team seats. Most users save 30–50% compared to equivalent Buffer or Hootsuite plans.",
    },
    {
        question: "What social platforms do you support?",
        answer:
            "We support Instagram, Facebook, X (Twitter), LinkedIn, Pinterest, TikTok, YouTube, and Google Business Profile. New integrations are added regularly based on user feedback.",
    },
    {
        question: "How many social accounts can I connect?",
        answer:
            "It depends on your plan. The Starter plan includes up to 5 accounts, Pro includes 20, and Agency is unlimited. You can mix and match any supported platforms.",
    },
    {
        question: "What is a social account?",
        answer:
            "A social account is a single profile on a platform — for example, your company's Instagram page or your LinkedIn profile. Each connected profile counts as one account toward your plan limit.",
    },
    {
        question: "Can I connect 2 accounts to the same platform?",
        answer:
            "Yes. For example, you can connect two separate Instagram business profiles. Each one counts as its own social account against your plan's limit.",
    },
    {
        question: "How many posts can I make and schedule per month?",
        answer:
            "All paid plans include unlimited scheduled posts. The free trial allows up to 30 scheduled posts per month so you can fully evaluate the scheduling experience.",
    },
    {
        question: "What types of content can I post?",
        answer:
            "You can post images, videos, carousels, stories, reels, text posts, and links. Supported formats vary slightly by platform — our composer will flag any incompatibilities before you publish.",
    },
];
---

<section class="w-full max-w-6xl mx-auto px-6 py-16 mt-18">
    <div class="flex flex-col lg:flex-row gap-16">

        <!-- Left: Header -->
        <div class="lg:w-2/5 flex-shrink-0">
            <h3 class="text-gray-900 text-4xl font-bold leading-tight">
                Frequently Asked Questions
            </h3>
            <p>
                Have another question? Contact me on{" "}
                <a href="https://wa.me/255689255545" target="_blank" rel="noopener noreferrer">
                    WhatsApp
                </a>{" "}
                or by{" "}
                <a href="mailto:nkonoki.charles@gmail.com" target="_blank" rel="noopener noreferrer">
                    Email
                </a>.
            </p>

        </div>

        <!-- Right: Accordion -->
        <div class="lg:w-3/5">
            {faqs.map((faq) => (
                    <details name="faq" class="faq-item group border-t border-gray-200 last:border-b">
                        <summary class="flex items-center justify-between gap-4 py-5 cursor-pointer list-none select-none">
            <span class="text-gray-800 text-base font-medium group-hover:text-accent-600 transition-colors duration-200">
              {faq.question}
            </span>

                            <!-- Plus / Minus icon via CSS -->
                            <span class="faq-icon flex-shrink-0 relative w-5 h-5 text-gray-400 group-hover:text-accent-500 transition-colors duration-200">
              <!-- Horizontal bar (always visible) -->
              <span class="absolute inset-y-1/2 left-0 right-0 h-px bg-current rounded" />
                                <!-- Vertical bar (fades & rotates away when open) -->
              <span class="absolute inset-x-1/2 top-0 bottom-0 w-px bg-current rounded transition-all duration-300 origin-center faq-vertical-bar" />
            </span>
                        </summary>

                        <!-- Grid-row trick: animates height without JS -->
                        <div class="faq-body overflow-hidden">
                            <p class="text-gray-500 text-sm leading-relaxed pb-5 min-h-0">
                                {faq.answer}
                            </p>
                        </div>
                    </details>
            ))}
        </div>

    </div>
</section>

<style>
    /* Smooth open/close via grid-template-rows — zero JS */
    .faq-body {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows 0.3s ease;
    }

    .faq-body p {
        overflow: hidden;
    }

    details[open] .faq-body {
        grid-template-rows: 1fr;
    }

    /* Collapse the vertical bar when open, turning + into — */
    details[open] .faq-vertical-bar {
        transform: rotate(90deg);
        opacity: 0;
    }

    /* Remove the native browser triangle marker */
    details > summary {
        list-style: none;
    }
    details > summary::-webkit-details-marker {
        display: none;
    }
</style>